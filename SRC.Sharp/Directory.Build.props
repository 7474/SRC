<Project>
  <!--
    SRC# のバージョン（docs/versioning.md）
    - アプリ（SRC#Form・SRC#Avalonia・SRC#Web・データビューア）: 3.<マイナー>.<パッチ>。2 までが VB 版、3 が SRC#
    - ライブラリ（SRCCore・SRCDataLinter・SRCRender・SRCSound）: 0.<マイナー>.<パッチ>
    マイナーとパッチは共通。マイナーは VB 版にならい奇数を開発版とする（5 が初版。4 はシナリオが参照しているため使わない）
    リリースはタグ（v3.<マイナー>.<パッチ>）を打った場合のみ。公開ワークフローでタグとこの値の一致を確かめる
  -->
  <PropertyGroup>
    <SrcSharpVersionMinor>5</SrcSharpVersionMinor>
    <SrcSharpVersionPatch>5</SrcSharpVersionPatch>
    <SrcSharpAppVersion>3.$(SrcSharpVersionMinor).$(SrcSharpVersionPatch)</SrcSharpAppVersion>
    <SrcSharpLibraryVersion>0.$(SrcSharpVersionMinor).$(SrcSharpVersionPatch)</SrcSharpLibraryVersion>
  </PropertyGroup>
  <!--
    開発版（master へのマージごとに出す dev のプレリリース。docs/versioning.md の「開発版」）。
    -p:SrcSharpDevBuild=<番号> を付けると、次のパッチのプレリリース（3.5.6-dev.<番号>・0.5.6-dev.<番号>）にする。
    正式版と同じ版にすると、NuGet のキャッシュで中身の違う開発版と正式版が混ざるため。
    プレリリースは正式版より小さいので、次の正式版が出れば置き換わる
  -->
  <PropertyGroup Condition="'$(SrcSharpDevBuild)' != ''">
    <SrcSharpDevPatch>$([MSBuild]::Add($(SrcSharpVersionPatch), 1))</SrcSharpDevPatch>
    <SrcSharpAppVersion>3.$(SrcSharpVersionMinor).$(SrcSharpDevPatch)-dev.$(SrcSharpDevBuild)</SrcSharpAppVersion>
    <SrcSharpLibraryVersion>0.$(SrcSharpVersionMinor).$(SrcSharpDevPatch)-dev.$(SrcSharpDevBuild)</SrcSharpLibraryVersion>
  </PropertyGroup>
</Project>
