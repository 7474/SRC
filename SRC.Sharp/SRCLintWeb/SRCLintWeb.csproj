<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    ブラウザで動く lint（srcsharp lint と同じ SRCAuthoring の DataLinter）。
    SRC#Web と違ってスレッドを使わないので、クロスオリジン分離（COOP/COEP）の無い頁からも読み込める。
    投稿サイト（7474/SRC-Site）がアップロードの前に zip を検査するのに使う。使い方は README.md
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <RootNamespace>SRCLintWeb</RootNamespace>
    <AssemblyName>SRCLintWeb</AssemblyName>
    <Version>$(SrcSharpAppVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shift_JIS のデータを読む（SRCAuthoring が CodePagesEncodingProvider を登録する） -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 起動を軽くするため AOT にしない（検査は数秒で済む） -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- JSExport はブラウザでだけ使う。プラットフォーム互換性アナライザーは WebAssembly の実行ファイルを考慮しない -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCAuthoring\SRCAuthoring.csproj" />
  </ItemGroup>

</Project>
