@page "/"
@using Microsoft.AspNetCore.Components.Forms
@using SRCDataViewer.Extensions
@using System.Diagnostics;

<section class="mt-5 mb-5">
    <div class="message">
        <div class="message-header">
            <p>SRC#DataViewer</p>
        </div>
        <div class="message-body">
            <p>@L["LoadDataIntro"]</p>
            <p>@L["LoadDataInstructionsBefore"]<a href="http://www.gsc.ne.jp/" target="_blank">GSC</a>@L["LoadDataInstructionsAfter"]</p>
        </div>
    </div>
    <div class="content">
        <InputFile OnChange="OnInputFileChange" multiple />
        <p>@L["SupportedFilesBefore"]<code>robot.txt, unit.txt, pilot.txt, pilot_message.txt, pilot_dialog.txt, item.txt</code>@L["SupportedFilesAfter"]</p>
        <p>@L["MultipleFilesHint"]</p>
    </div>
</section>

<TitleView SRC="@SRC" DataTitle="" />
<div id="status" class="message">@StatusText</div>

@code {
    private SRC SRC = new SRC();
    private string StatusText = "";

    protected override async Task OnInitializedAsync()
    {
        SRC.InitSPDList();
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        var sw = new Stopwatch();
        sw.Start();
        const int maxFileSize = 10 * 1024 * 1024; // 10MB
        foreach (var file in e.GetMultipleFiles(20))
        {
            switch (file.Name.ToLower())
            {
                case "unit.txt":
                case "robot.txt":
                    SRC.UDList.Load(file.Name, await file.OpenReadStream(maxFileSize).ToUTF8Async());
                    break;
                case "pilot.txt":
                    SRC.PDList.Load(file.Name, await file.OpenReadStream(maxFileSize).ToUTF8Async());
                    break;
                case "pilot_message.txt":
                    SRC.MDList.Load(file.Name, false, await file.OpenReadStream(maxFileSize).ToUTF8Async());
                    break;
                case "pilot_dialog.txt":
                    SRC.DDList.Load(file.Name, await file.OpenReadStream(maxFileSize).ToUTF8Async());
                    break;
                case "item.txt":
                    SRC.IDList.Load(file.Name, await file.OpenReadStream(maxFileSize).ToUTF8Async());
                    break;
                default:
                    Console.WriteLine($"Not supported file [{file.Name}]");
                    break;
            }
            Console.WriteLine($"{sw.ElapsedMilliseconds}ms [{file.Name}]");
        }
        sw.Stop();
        Console.WriteLine(sw.ElapsedMilliseconds);
        //StatusText = $"{sw.ElapsedMilliseconds}ms";
        StateHasChanged();
    }
}
