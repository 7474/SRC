                Effective = SingleAxes.Select(m => Store.SingleIndex(x, m)).ToList(),
            }).ToList();
            <div class="columns is-multiline">
                <div class="column is-12-tablet is-5-desktop">
                    <RadarChart Axes="SingleAxes" Series="series" Title="@L["CompareSideBySide"]" />
                    <p class="is-size-7 mt-2"><a href="@NavigationManager.Uri">@L["CompareShare"]</a></p>
                </div>
                <div class="column is-12-tablet is-7-desktop">
                    <div class="table-container">
                        <table class="table is-narrow is-fullwidth src-compare-side src-compare-single-side">
                            <thead>
                                <tr>
