<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Version>$(SrcSharpLibraryVersion)</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>srcsharp</ToolCommandName>
    <PackageId>SRCSharpTools</PackageId>
    <AssemblyName>srcsharp</AssemblyName>
    <Description>SRC# のデータ・シナリオの作成支援ツール（lint・自動プレイ・バランス集計・Language Server・デバッガ）</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 表示の言語。既定（ニュートラル）は日本語で、英語は Resources/Strings.en.resx -->
    <NeutralLanguage>ja</NeutralLanguage>
    <SatelliteResourceLanguages>ja;en;zh-Hans;zh-Hant;ko;fr;de;es;pt-BR;it;ru;pl;tr;th;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCAuthoring\SRCAuthoring.csproj" />
    <ProjectReference Include="..\SRCDebugAdapter\SRCDebugAdapter.csproj" />
    <ProjectReference Include="..\SRCPlay\SRCPlay.csproj" />
  </ItemGroup>

</Project>
