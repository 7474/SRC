<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Version>$(SrcSharpLibraryVersion)</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>srcsharp</ToolCommandName>
    <PackageId>SRCSharpTools</PackageId>
    <AssemblyName>srcsharp</AssemblyName>
    <Description>SRC# のデータ・シナリオの作成支援ツール（lint・自動プレイ・バランス集計・Language Server・デバッガ）</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- 表示の言語。既定（ニュートラル）は日本語で、英語は Resources/Strings.en.resx -->
    <NeutralLanguage>ja</NeutralLanguage>
    <SatelliteResourceLanguages>ja;en;zh-Hans;zh-Hant;ko;fr;de;es;pt-BR;it;ru;pl;tr;th;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- srcsharp help で引くヘルプ（HelpDocument）。Docker イメージもリポジトリのルートをコンテキストにして含める -->
    <EmbeddedResource Include="..\..\SRC.Sharp.Help\src\*.md" Exclude="..\..\SRC.Sharp.Help\src\404.md" LogicalName="help/%(Filename)%(Extension)" Link="Help\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    srcsharp help の検索のベクトル（help-vectors.bin）。SRCHelpSearch を実行してヘルプの断片の埋め込みを作り、埋め込む。
    埋め込みのモデルを取れなかった（SRCHelpSearch の出力に help-model が無い）ときは作らず、全文検索だけになる
  -->
  <Target Name="FindHelpSearchTool" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_HelpMarkdown Include="..\..\SRC.Sharp.Help\src\*.md" />
      <_HelpSearchTool Include="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'SRCHelpSearch' And Exists('%(RootDir)%(Directory)help-model\model_int8.onnx')" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateHelpVectors" AfterTargets="FindHelpSearchTool" Inputs="@(_HelpMarkdown);@(_HelpSearchTool)" Outputs="$(IntermediateOutputPath)help-vectors.bin">
    <PropertyGroup>
      <_DotnetHost>$(DOTNET_HOST_PATH)</_DotnetHost>
      <_DotnetHost Condition="'$(_DotnetHost)' == ''">dotnet</_DotnetHost>
    </PropertyGroup>
    <Exec Condition="'@(_HelpSearchTool)' != ''" Command="&quot;$(_DotnetHost)&quot; &quot;@(_HelpSearchTool)&quot; &quot;$(MSBuildProjectDirectory)\..\..\SRC.Sharp.Help\src&quot; &quot;$(IntermediateOutputPath)help-vectors.bin&quot;" />
  </Target>

  <Target Name="EmbedHelpVectors" AfterTargets="GenerateHelpVectors" BeforeTargets="PrepareResources">
    <ItemGroup Condition="'@(_HelpSearchTool)' != '' And Exists('$(IntermediateOutputPath)help-vectors.bin')">
      <EmbeddedResource Include="$(IntermediateOutputPath)help-vectors.bin" LogicalName="help-vectors.bin" />
    </ItemGroup>
  </Target>

  <!--
    .NET tool では使わないネイティブのファイルを発行しない（NuGet.org のパッケージの上限 250MB に収めるため）。
    ONNX Runtime の Android・iOS 用とリンク用の .lib、SkiaSharp などのネイティブのライブラリのデバッグシンボル（runtimes の下の .pdb）
  -->
  <Target Name="RemoveUnusedNativeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedNativeFile Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/android/')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/ios/')) Or ($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Contains('onnxruntime')) And '%(ResolvedFileToPublish.Extension)' == '.lib') Or ($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('runtimes/')) And '%(ResolvedFileToPublish.Extension)' == '.pdb')" />
      <ResolvedFileToPublish Remove="@(_UnusedNativeFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCAuthoring\SRCAuthoring.csproj" />
    <ProjectReference Include="..\SRCDebugAdapter\SRCDebugAdapter.csproj" />
    <ProjectReference Include="..\SRCHelpSearch\SRCHelpSearch.csproj" />
    <ProjectReference Include="..\SRCLogging\SRCLogging.csproj" />
    <ProjectReference Include="..\SRCPlay\SRCPlay.csproj" />
  </ItemGroup>

</Project>
