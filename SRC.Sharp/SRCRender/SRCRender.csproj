<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>$(SrcSharpLibraryVersion)</Version>
    <RootNamespace>SRCRender</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- 表示文字列（Resources/Strings.resx）の既定は日本語。英語は Strings.en.resx（docs/i18n.md） -->
    <NeutralLanguage>ja</NeutralLanguage>
    <SatelliteResourceLanguages>ja;en;zh-Hans;zh-Hant;ko;fr;de;es;pt-BR;it;ru;pl;tr;th;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Skia が依存する版に合わせる -->
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SRCRenderTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
  </ItemGroup>

</Project>
