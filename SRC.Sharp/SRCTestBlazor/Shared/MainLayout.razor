@inherits LayoutComponentBase
<nav class="navbar is-fixed-top src-navbar-top" role="navigation" aria-label="main navigation">
    <div class="navbar-brand">
        <NavLink class="navbar-item" href="#">SRC#DataViewer</NavLink>
        <a role="button"
           aria-label="menu" aria-expanded="false"
           class="navbar-burger @(IsBurgerActive ? " is-active" : "" )"
           @onclick="OnClickBurger">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
        <div class="navbar-item">
            <button class="button is-small" @onclick="OnClickSettings" title="@L["DisplaySettings"]">
                <span class="icon">
                    <i class="fas fa-cog"></i>
                </span>
            </button>
        </div>
    </div>
    <div class="navbar-menu  @(IsBurgerActive ? " is-active" : "" )">
        <nav class="navbar" role="navigation" aria-label="dropdown navigation">
            <div class="navbar-item has-dropdown is-hoverable">
                <a class="navbar-link">
                    <span class="icon">
                        @if (TitlesBusy)
                        {
                            <i class="fas fa-spinner"></i>
                        }
                        else
                        {
                            <i class="far fa-folder"></i>
                        }
                    </span>
                    <span>Titles</span>
                </a>
                <div class="navbar-dropdown">
                    <TitleNavMenu />
                </div>
            </div>
            @if (ArchiveCatalog.Enabled)
            {
                <NavLink class="navbar-item" href="archives">
                    <span class="icon"><i class="far fa-file-archive"></i></span>
                    <span>@L["Archives"]</span>
                </NavLink>
            }
        </nav>
    </div>
</nav>

<main class="container is-max-desktop">
    @Body
</main>

<BgmBar />

<SettingsModal IsVisible="@IsSettingsModalVisible" OnClose="OnSettingsModalClose" />

@implements IDisposable
@code {
    [Inject]
    protected NavigationManager NavigationManager { get; set; }
    [Inject]
    protected IJSRuntime JsInterop { get; set; }
    [Inject]
    private SrcDataContainer DataContainer { get; set; }
    [Inject]
    private DataViewerSettingsService SettingsService { get; set; }
    [Inject]
    private ArchiveCatalog ArchiveCatalog { get; set; }
    [Inject]
    private HttpClient Http { get; set; }
        
    private bool IsBurgerActive = false;
    private bool IsSettingsModalVisible = false;
    private bool TitlesBusy => DataContainer.IndexBusy;

    private void OnClickBurger()
    {
        IsBurgerActive = !IsBurgerActive;
    }

    private void OnClickSettings()
    {
        IsSettingsModalVisible = true;
    }

    private void OnSettingsModalClose()
    {
        IsSettingsModalVisible = false;
    }

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        DataContainer.OnChange += StateHasChanged;
        ArchiveCatalog.OnChange += OnArchiveCatalogChanged;
        await SettingsService.InitializeAsync();
        // 置いたサイトがアーカイブの一覧を設定していれば（viewer.json）、メニューに出す
        await ArchiveCatalog.EnsureLoadedAsync(Http);
    }

    private void OnArchiveCatalogChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DataContainer.OnChange -= StateHasChanged;
        ArchiveCatalog.OnChange -= OnArchiveCatalogChanged;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    private async void HandleLocationChanged(object sender, LocationChangedEventArgs e)
    {
        // ナビゲーションがあったらハンバーガーを閉じる
        IsBurgerActive = false;
        // ドロップダウンを閉じるためにフォーカスを外す
        await JsInterop.InvokeVoidAsync("bulma.blur", null);

        StateHasChanged();
    }
}
