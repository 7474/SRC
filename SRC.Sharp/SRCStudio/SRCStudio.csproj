<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    SRC#Studio（作成支援の画面）の計算。マップの読み書き・地形データ・マップの画像の探し方を、SRCCore と同じ処理で行う（7474/SRC#1641）。
    画面（wwwroot の HTML・JavaScript）から JSExport で呼ぶ。スタンドアロンの Web アプリ（GitHub Pages の /SRC/studio/）と、
    VS Code 拡張のカスタムエディタ（同じ wwwroot を .vsix に入れる）の両方で動く。スレッドを使わない（クロスオリジン分離が要らない）
  -->
  <PropertyGroup>
    <TargetFramework>$(SrcSharpTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <RootNamespace>SRCStudio</RootNamespace>
    <AssemblyName>SRCStudio</AssemblyName>
    <Version>$(SrcSharpAppVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Shift_JIS のデータを読む（SRCAuthoring が CodePagesEncodingProvider を登録する） -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 起動を軽くするため AOT にしない -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- JSExport はブラウザでだけ使う。プラットフォーム互換性アナライザーは WebAssembly の実行ファイルを考慮しない -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCAuthoring\SRCAuthoring.csproj" />
  </ItemGroup>

</Project>
