{
  "name": "src-vscode",
  "displayName": "SRC# Authoring",
  "description": "Authoring support for SRC (Simulation RPG Construction) event scripts (*.eve): diagnostics, outline, go to definition, completion and an event debugger. Requires the srcsharp .NET tool.",
  "version": "0.6.0",
  "publisher": "koudenpa",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/7474/SRC/blob/master/SRC.Sharp/SRCSharpVSCode/README.md",
  "bugs": {
    "url": "https://github.com/7474/SRC/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7474/SRC.git",
    "directory": "SRC.Sharp/SRCSharpVSCode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Programming Languages", "Debuggers", "Linters"],
  "keywords": ["SRC", "Simulation RPG Construction", "SRPG", "eve", "srcsharp"],
  "galleryBanner": {
    "color": "#2b2b2b",
    "theme": "dark"
  },
  "activationEvents": [
    "onDebugResolve:srcsharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "src-eve",
        "aliases": ["SRC Event", "src-eve"],
        "extensions": [".eve"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "src-data",
        "aliases": ["SRC Data", "src-data"],
        "filenames": ["alias.txt", "animation.txt", "battle.txt", "effect.txt", "ext_animation.txt", "item.txt", "mind.txt", "non_pilot.txt", "pilot.txt", "pilot_dialog.txt", "pilot_message.txt", "robot.txt", "sp.txt", "terrain.txt", "unit.txt"],
        "configuration": "./src-data-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "src-eve",
        "scopeName": "source.src-eve",
        "path": "./syntaxes/src-eve.tmLanguage.json"
      },
      {
        "language": "src-data",
        "scopeName": "source.src-data",
        "path": "./syntaxes/src-data.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[src-eve]": {
        "files.encoding": "shiftjis",
        "files.autoGuessEncoding": true
      },
      "[src-data]": {
        "files.encoding": "shiftjis",
        "files.autoGuessEncoding": true
      }
    },
    "configuration": {
      "title": "SRC#",
      "properties": {
        "srcsharp.serverPath": {
          "type": "string",
          "default": "srcsharp",
          "description": "srcsharp コマンド（dotnet tool install -g SRCSharpTools）。dotnet で dll を動かす場合は dotnet を指定し、serverArgs に dll のパスを入れる"
        },
        "srcsharp.serverArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "srcsharp の前に付ける引数（例: [\"path/to/srcsharp.dll\"]）"
        },
        "srcsharp.appPath": {
          "type": "string",
          "default": "",
          "description": "SRC 本体のフォルダ（Lib や共通の Data を探す）"
        }
      }
    },
    "breakpoints": [
      { "language": "src-eve" }
    ],
    "debuggers": [
      {
        "type": "srcsharp",
        "label": "SRC# イベント",
        "languages": ["src-eve"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "実行するイベントファイル", "default": "${file}" },
              "script": { "type": "string", "description": "入力を与える .play スクリプト（無ければメッセージを送り、選択肢は先頭を選ぶ）" },
              "appPath": { "type": "string", "description": "SRC 本体のフォルダ（無ければシナリオのフォルダ）" },
              "stopOnEntry": { "type": "boolean", "description": "最初のコマンドで止める", "default": false },
              "maxSteps": { "type": "number", "description": "自動で進める操作の上限", "default": 100000 }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "srcsharp",
            "request": "launch",
            "name": "SRC# イベントを実行",
            "program": "${file}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "SRC#: イベントを実行",
            "body": { "type": "srcsharp", "request": "launch", "name": "SRC# イベントを実行", "program": "^\"\\${file}\"", "stopOnEntry": true }
          },
          {
            "label": "SRC#: .play スクリプトで実行",
            "body": { "type": "srcsharp", "request": "launch", "name": "SRC# スクリプトで実行", "program": "^\"\\${workspaceFolder}/test.eve\"", "script": "^\"\\${workspaceFolder}/test.play\"" }
          }
        ]
      }
    ],
    "commands": [
      { "command": "srcsharp.lint", "title": "SRC#: ワークスペースを lint する" },
      { "command": "srcsharp.balance", "title": "SRC#: バランスレポートを作る" },
      { "command": "srcsharp.play", "title": "SRC#: このイベントを自動プレイする" }
    ]
  },
  "scripts": {
    "check-types": "tsc -p ./ --noEmit",
    "compile": "npm run check-types && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --sourcemap --watch",
    "vscode:prepublish": "npm run check-types && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20 --minify",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "typescript": "~5.9.3"
  }
}
