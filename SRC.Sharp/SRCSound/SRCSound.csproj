<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SRCSound</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAL のバインディング（MIT）。https://github.com/dotnet/Silk.NET -->
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- OpenAL Soft のネイティブライブラリ（LGPL-2.0-or-later、動的リンク）。https://github.com/kcat/openal-soft -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- MP3 デコーダ（MIT）。https://github.com/naudio/NLayer -->
    <PackageReference Include="NLayer" Version="3.0.0" />
    <!-- MIDI シンセサイザ（MIT、SoundFont が必要）。https://github.com/sinshu/meltysynth -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
  </ItemGroup>

</Project>
