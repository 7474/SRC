<Project>
  <!--
    NuGet の版はここで 1 か所に決める（Central Package Management）。プロジェクトは PackageReference に版を書かない。
    Dependabot はこのファイルを更新するので、プロジェクトごとに版がずれない（#1352）
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageVersion Include="MeltySynth" Version="2.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageVersion Include="NAudio" Version="3.3.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NLayer" Version="3.0.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="ShiftJISExtension" Version="1.1.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="SkiaSharp" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.155.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.155.0" />
    <PackageVersion Include="System.Collections.Specialized" Version="4.3.0" />
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="System.Runtime.Caching" Version="11.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0" />
  </ItemGroup>
  <!--
    SRC#Web だけ SkiaSharp を 4.156 の RC にする。
    SkiaSharp の WebAssembly のネイティブライブラリは Emscripten の版ごとに入っていて、.NET 11（Emscripten 6.0.2）向けは 4.156 から（4.155.0 は 3.1.34・3.1.56・5.0.6 だけ）。
    デスクトップ（SRC#Avalonia・SRCRender など）は正式版の 4.155.0 のまま。SkiaSharp は管理側とネイティブの版をそろえる（dependabot.yml）。
    4.156.0 の正式版が出たら、上の版を上げてこのグループを消す（docs/dotnet-upgrade.md）
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SRCSharpWeb'">
    <PackageVersion Update="SkiaSharp" Version="4.156.0-rc.1.26553.11" />
    <PackageVersion Update="SkiaSharp.NativeAssets.WebAssembly" Version="4.156.0-rc.1.26553.11" />
  </ItemGroup>
</Project>
