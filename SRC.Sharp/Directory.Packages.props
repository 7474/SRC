<Project>
  <!--
    NuGet の版はここで 1 か所に決める（Central Package Management）。プロジェクトは PackageReference に版を書かない。
    Dependabot はこのファイルを更新するので、プロジェクトごとに版がずれない（#1352）
    https://learn.microsoft.com/nuget/consume-packages/central-package-management
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Headless" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Skia" Version="12.2.0" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageVersion Include="MeltySynth" Version="2.4.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="NAudio" Version="3.3.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NLayer" Version="3.0.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="ShiftJISExtension" Version="1.1.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!--
      SkiaSharp は 4.156.x に留める。4.157.0 は LibraryImport に [UnmanagedCallConv] を付けたため、
      .NET 11.0.0 の Mono の AOT コンパイラが SRC#Web の発行で落ちる（sgen-alloc.c:409。dotnet/runtime#136351、mono/SkiaSharp#5840）。
      修正（dotnet/runtime#136627）が入った .NET 11 のサービスの版に上げたら 4.157 以降にする（7474/SRC#1705。.github/dependabot.yml の ignore も消す）
    -->
    <PackageVersion Include="SkiaSharp" Version="4.156.3" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.2" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.156.3" />
    <PackageVersion Include="System.Collections.Specialized" Version="4.3.0" />
    <PackageVersion Include="System.Drawing.Common" Version="11.0.0" />
    <PackageVersion Include="System.Runtime.Caching" Version="11.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0" />
  </ItemGroup>
</Project>
