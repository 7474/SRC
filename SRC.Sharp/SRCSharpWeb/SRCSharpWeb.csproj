<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>SRCSharpWeb</RootNamespace>
    <AssemblyName>SRCSharpWeb</AssemblyName>
    <Product>SRC#Web</Product>
    <Version>$(SrcSharpAppVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ゲームスレッドを Web Worker で動かす。クロスオリジン分離（COOP/COEP）が必要 -->
    <WasmEnableThreads>true</WasmEnableThreads>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Shift_JIS の zip のファイル名を読むため -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 表示言語を起動時に選ぶ（WebLocalization.cs）。カルチャを変えるには ICU のデータをすべて読み込む -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <!-- 既定（ニュートラル）の文言は日本語。訳（*.<カルチャ名>.resx）はサテライトアセンブリにせず、このアセンブリに埋め込む。
         マルチスレッドの WebAssembly では、Blazor がサテライトアセンブリを読み込むと「Cannot call synchronous C# methods」で起動に失敗するため。
         SRCCore.EmbeddedCultureResourceManager が埋め込んだ訳を引く -->
    <NeutralLanguage>ja</NeutralLanguage>
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- スレッドを使うが、プラットフォーム互換性アナライザーはマルチスレッドの WebAssembly を考慮しない -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.4" />
    <!-- MIDI シンセサイザ（MIT、SoundFont が必要）。https://github.com/sinshu/meltysynth -->
    <PackageReference Include="MeltySynth" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\WebStrings.*.resx" WithCulture="false" LogicalName="SRCSharpWeb.Resources.%(Filename).resources" />
    <EmbeddedResource Include="..\SRCRender\Resources\Strings.*.resx" Link="Resources\SRCRender\%(Filename)%(Extension)" WithCulture="false" LogicalName="SRCRender.Resources.%(Filename).resources" />
  </ItemGroup>

  <ItemGroup>
    <!-- SRCSound は OpenAL を使うため参照せず、MIDI の合成部分だけを共有する -->
    <Compile Include="..\SRCSound\ISampleSource.cs" Link="Sound\ISampleSource.cs" />
    <Compile Include="..\SRCSound\MidiSource.cs" Link="Sound\MidiSource.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
    <ProjectReference Include="..\SRCRender\SRCRender.csproj" />
  </ItemGroup>

  <!--
    ビルド時に用意する静的ファイル（リポジトリには含めない）
    - fonts/: OFL の日本語フォント（BIZ UD ゴシック・明朝）。google/fonts から取得する
    - scenarios/: 登録済シナリオ。遊べるシナリオ（SRC.Sharp/Content/lantern）と E2E のコーパス（SRC.Sharp/E2E）を zip にし、一覧（catalog.json）を作る
    - assets/: 素材。自作の最小の汎用データ（SRC.Sharp/Content/basic-data）を zip にする。遊べるシナリオが requires で重ねる
  -->
  <PropertyGroup>
    <GoogleFontsCommit>66928797f271fed5ee428544e7229685e2d90127</GoogleFontsCommit>
    <GoogleFontsBase>https://raw.githubusercontent.com/google/fonts/$(GoogleFontsCommit)/ofl</GoogleFontsBase>
    <E2EDir>$(MSBuildThisFileDirectory)..\E2E\</E2EDir>
    <ContentDir>$(MSBuildThisFileDirectory)..\Content\</ContentDir>
  </PropertyGroup>

  <ItemGroup>
    <WebFont Include="bizudgothic/BIZUDGothic-Regular.ttf" />
    <WebFont Include="bizudpgothic/BIZUDPGothic-Regular.ttf" />
    <WebFont Include="bizudmincho/BIZUDMincho-Regular.ttf" />
    <WebFont Include="bizudpmincho/BIZUDPMincho-Regular.ttf" />
    <WebFont Include="bizudgothic/OFL.txt" />
  </ItemGroup>

  <Target Name="PrepareWebContent" BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths">
    <ItemGroup>
      <_WebFont Include="@(WebFont)" TargetFile="wwwroot/fonts/%(Filename)%(Extension)" />
      <_E2ECase Include="$([System.IO.Directory]::GetDirectories('$(E2EDir)'))" />
      <_E2ECase Update="@(_E2ECase)" CaseName="$([System.IO.Path]::GetFileName('%(Identity)'))" />
      <!-- 素材の zip には作成用のスクリプト（make.py）を入れない -->
      <_BasicData Include="$(ContentDir)basic-data\**\*" Exclude="$(ContentDir)basic-data\make.py" />
    </ItemGroup>
    <MakeDir Directories="wwwroot/fonts;wwwroot/scenarios;wwwroot/assets" />
    <RemoveDir Directories="$(IntermediateOutputPath)basic-data" />
    <Copy SourceFiles="@(_BasicData)" DestinationFiles="@(_BasicData->'$(IntermediateOutputPath)basic-data\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)basic-data" DestinationFile="wwwroot/assets/basic-data.zip" Overwrite="true" />
    <ZipDirectory SourceDirectory="$(ContentDir)lantern" DestinationFile="wwwroot/scenarios/lantern.zip" Overwrite="true" />
    <GetFileHash Files="wwwroot/assets/basic-data.zip;wwwroot/scenarios/lantern.zip" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_ContentZip" />
    </GetFileHash>
    <DownloadFile SourceUrl="$(GoogleFontsBase)/%(_WebFont.Identity)" DestinationFolder="wwwroot/fonts" Condition="!Exists('%(_WebFont.TargetFile)')" Retries="3" />
    <ZipDirectory SourceDirectory="%(_E2ECase.Identity)" DestinationFile="wwwroot/scenarios/%(_E2ECase.CaseName).zip" Overwrite="true" />
    <!-- zip の版（ブラウザのキャッシュの更新判定）には zip のハッシュ値を使う -->
    <GetFileHash Files="@(_E2ECase->'wwwroot/scenarios/%(CaseName).zip')" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_E2EZip" />
    </GetFileHash>
    <PropertyGroup>
      <_BasicDataVersion>@(_ContentZip->WithMetadataValue('Filename', 'basic-data')->'%(FileHash)')</_BasicDataVersion>
      <_LanternVersion>@(_ContentZip->WithMetadataValue('Filename', 'lantern')->'%(FileHash)')</_LanternVersion>
      <!-- 遊べるシナリオを先頭に置く。素材（kind: asset）は一覧に出ない -->
      <_Playable>{ &quot;id&quot;: &quot;lantern&quot;, &quot;title&quot;: &quot;灯の巡航船ランタン号&quot;, &quot;description&quot;: &quot;全五話＋終話の短いオリジナルシナリオ&quot;, &quot;license&quot;: &quot;GPL-3.0&quot;, &quot;archive&quot;: &quot;scenarios/lantern.zip&quot;, &quot;version&quot;: &quot;$(_LanternVersion)&quot;, &quot;eve&quot;: &quot;01_灯の港.eve&quot;, &quot;requires&quot;: [ &quot;basic-data&quot; ] }, { &quot;id&quot;: &quot;basic-data&quot;, &quot;kind&quot;: &quot;asset&quot;, &quot;title&quot;: &quot;SRC# の最小の汎用データ&quot;, &quot;license&quot;: &quot;GPL-3.0&quot;, &quot;archive&quot;: &quot;assets/basic-data.zip&quot;, &quot;version&quot;: &quot;$(_BasicDataVersion)&quot; }</_Playable>
      <!-- E2E のコーパスも、SRC 本体の Lib（インターミッションのステータス表示など）として最小の汎用データを重ねる -->
      <_Catalog>$(_Playable), @(_E2EZip->'{ &quot;id&quot;: &quot;%(CaseName)&quot;, &quot;title&quot;: &quot;%(CaseName)&quot;, &quot;archive&quot;: &quot;scenarios/%(CaseName).zip&quot;, &quot;version&quot;: &quot;%(FileHash)&quot;, &quot;eve&quot;: &quot;test.eve&quot;, &quot;requires&quot;: [ &quot;basic-data&quot; ] }', ', ')</_Catalog>
    </PropertyGroup>
    <WriteLinesToFile File="wwwroot/scenarios/catalog.json" Lines="[ $(_Catalog) ]" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="utf-8" />
    <ItemGroup>
      <Content Include="wwwroot/fonts/**;wwwroot/scenarios/**;wwwroot/assets/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

  <!-- 参照するプロジェクト（SRCRender）のサテライトアセンブリも配らない（SatelliteResourceLanguages はパッケージのものにしか効かない）。訳は上の EmbeddedResource で埋め込む -->
  <Target Name="RemoveReferenceSatelliteAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceSatellitePaths Remove="@(ReferenceSatellitePaths)" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').EndsWith('.resources'))" />
    </ItemGroup>
  </Target>
</Project>
