@using SRCRender
@using System.IO
@using System.Threading
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<WebStrings> L
@inject Microsoft.Extensions.Logging.ILoggerFactory LoggerFactory

@if (mode == Mode.Playing || mode == Mode.Ended)
{
    <div class="play">
    <div class="screen-wrap">
        <canvas id="screen" width="@ScreenLayout.Width" height="@ScreenLayout.Height" tabindex="0"></canvas>
        @* タッチ向けの選択画面（タッチの端末で、ゲームのリスト・メニュー・ダイアログを大きなボタンで出す）。中身は srcweb.js が作る *@
        <div id="touch-ui" class="touch-ui" role="dialog" hidden data-cancel="@L["TouchCancel"]"></div>
        @if (mode == Mode.Ended)
        {
            <div class="ended">
                <div class="dialog" role="dialog" aria-label="@L["Ended"]">
                    <div class="titlebar">SRC#Web</div>
                    <div class="dialog-body">
                        <p>@L["ScenarioEnded"]</p>
                        <div class="dialog-buttons">
                            <button @onclick="BackToMenu">@L["BackToMenu"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @* プレイ中の操作は画面の右下の控えめなメニューにまとめる（誤って押してもすぐには終わらない） *@
    <div class="screen-bar">
        @* 仮想パッド（タッチの端末向け）。中身は srcweb.js が作る *@
        <div id="virtual-pad" class="virtual-pad" hidden></div>
        <div class="system-menu">
            <button id="system-menu-button" class="system-button" title="@L["SystemMenu"]" aria-label="@L["SystemMenu"]"
                    aria-haspopup="menu" aria-expanded="@(systemMenuOpen ? "true" : "false")" @onclick="ToggleSystemMenu">≡</button>
            @if (systemMenuOpen)
            {
                <div class="menu-backdrop" @onclick="CloseSystemMenu"></div>
                <div class="popup-menu" role="menu">
                    <button role="menuitem" @onclick="AskBackToMenu">@L["MenuBackToMenu"]</button>
                    <button role="menuitem" @onclick="ToggleFullscreenAsync">@L["MenuFullscreen"]</button>
                    <button role="menuitem" @onclick="ToggleVirtualPadAsync">@L["MenuVirtualPad"]</button>
                    <button role="menuitem" @onclick="ToggleTouchUiAsync">@L["MenuTouchUi"]</button>
                    <hr />
                    <button role="menuitem" @onclick="CloseSystemMenu">@L["MenuClose"]</button>
                </div>
            }
        </div>
    </div>
    @if (confirmingBack)
    {
        <div class="modal">
            <div class="dialog" role="alertdialog" aria-label="@L["Confirm"]">
                <div class="titlebar">SRC#Web</div>
                <div class="dialog-body">
                    <p>@L["ConfirmBackToMenu"]<br />@L["UnsavedProgressLost"]</p>
                    <div class="dialog-buttons">
                        <button @onclick="BackToMenu">@L["Yes"]</button>
                        <button id="confirm-no" @onclick="CancelBack">@L["No"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    @* エクスプローラー（Windows 95・XP）を模した画面。右の一覧を DOM の先に置き、左の作業ウィンドウは CSS で左に出す *@
    <main class="window explorer">
        <div class="titlebar">
            <span class="title-icon" aria-hidden="true"></span>
            <h1>@site.Title</h1>
            <span class="caption-buttons" aria-hidden="true"><span class="caption-min"></span><span class="caption-max"></span><span class="caption-close"></span></span>
        </div>
        <div class="addressbar">
            <span class="address-label">@L["Address"]</span>
            <span class="address"><span class="icon icon-folder" aria-hidden="true"></span>@AddressText</span>
        </div>
        @* シナリオ・素材を読み込んでいる間は、ほかの操作を受け付けない（inert） *@
        <div class="explorer-body" inert="@busy" aria-busy="@(busy ? "true" : "false")">
        <div class="listpane">
        @if (!string.IsNullOrEmpty(status))
        {
            <p id="status" class="status">@status</p>
        }
        @if (mode == Mode.Menu)
        {
            @foreach (var catalog in catalogs)
            {
                <section class="group catalog">
                    <h2>@(catalog.Name ?? L["RegisteredScenarios"])</h2>
                    @if (!catalog.Scenarios.Any())
                    {
                        <p class="note">@L["NoItems"]</p>
                    }
                    @* E2E テストは最初のカタログを #catalog で探す *@
                    <ul class="items" id="@(catalogs.IndexOf(catalog) == 0 ? "catalog" : null)">
                        @foreach (var entry in catalog.Scenarios)
                        {
                            <li>
                                <span class="icon icon-zip" aria-hidden="true"></span>
                                <button @onclick="() => PlayCatalogAsync(entry)">@entry.Title</button>
                                @if (!string.IsNullOrEmpty(entry.Author))
                                {
                                    <span class="note">@entry.Author</span>
                                }
                                @if (!string.IsNullOrEmpty(entry.License))
                                {
                                    <span class="note">@entry.License</span>
                                }
                                <a class="link" href="@PlayLink(entry)" title="@L["DirectLinkTitle"]">@L["DirectLink"]</a>
                            </li>
                        }
                    </ul>
                    @if (userCatalogs.Contains(catalog.Url))
                    {
                        <button class="delete" @onclick="() => RemoveCatalogAsync(catalog.Url)">@L["RemoveCatalog"]</button>
                    }
                </section>
            }
            @foreach (var error in catalogErrors)
            {
                <p class="status">@error</p>
            }
            @if (site.AllowUserArchives)
            {
                <section class="group">
                    <h2>@L["AddedArchives"]</h2>
                    <ul class="items" id="archives">
                        @foreach (var archive in archives)
                        {
                            <li>
                                @if (archive.Kind == CatalogEntry.KindAsset)
                                {
                                    <span class="icon icon-asset" aria-hidden="true"></span>
                                    <span class="name">@archive.Name</span>
                                    <span class="asset">@L["Asset"]</span>
                                }
                                else
                                {
                                    <span class="icon icon-zip" aria-hidden="true"></span>
                                    <button @onclick="() => PlayArchiveAsync(archive)">@archive.Name</button>
                                }
                                <span class="size">@FormatSize(archive.Size)</span>
                                <button class="delete" @onclick="() => DeleteArchiveAsync(archive)">@L["Delete"]</button>
                            </li>
                        }
                    </ul>
                    @if (archives.Count == 0)
                    {
                        <p class="note">@L["NoItems"]</p>
                    }
                </section>
            }
        }
        else if (mode == Mode.ChooseEvent)
        {
            <section class="group">
                <h2>@choosingTitle</h2>
                @if (saves.Count > 0)
                {
                    <h3>@L["ResumeFromSave"]</h3>
                    <ul class="items" id="saves">
                        @foreach (var save in saves)
                        {
                            <li>
                                <span class="icon icon-save" aria-hidden="true"></span>
                                <button @onclick="() => StartAsync(Path.Combine(scenarioDir, save.Name))">@save.Name</button>
                                <span class="size">@FormatTime(save.Updated)</span>
                                <button class="export" @onclick="() => ExportSaveAsync(save)">@L["Export"]</button>
                                <button class="delete" @onclick="() => DeleteSaveAsync(save)">@L["Delete"]</button>
                            </li>
                        }
                    </ul>
                }
                <h3>@L["StartNew"]</h3>
                <ul class="items" id="events">
                    @foreach (var eve in eventFiles)
                    {
                        <li><span class="icon icon-file" aria-hidden="true"></span><button @onclick="() => StartAsync(Path.Combine(scenarioDir, eve))">@eve</button></li>
                    }
                </ul>
            </section>
        }
        </div>
        @if (mode == Mode.Menu || mode == Mode.ChooseEvent)
        {
            <aside class="taskpane">
            @if (mode == Mode.Menu)
            {
                @if (site.AllowUserCatalogs)
                {
                    <section class="task">
                        <h2>@L["AddCatalog"]</h2>
                        <div class="task-body">
                            <p class="note">@L["AddCatalogNote"]</p>
                            <form class="add-catalog" @onsubmit="AddCatalogAsync">
                                <input id="catalog-url" type="url" placeholder="https://example.com/catalog.json" @bind="newCatalogUrl" />
                                <button type="submit">@L["Add"]</button>
                            </form>
                        </div>
                    </section>
                }
                @if (site.AllowUserArchives)
                {
                    <section class="task">
                        <h2>@L["AddArchives"]</h2>
                        <div class="task-body">
                            <p class="note">@L["AddArchiveNote"]</p>
                            <InputFile id="add-archive" OnChange="e => AddArchivesAsync(e, CatalogEntry.KindScenario)" accept=".zip" multiple />
                            <p class="note">@L["AddAssetNote"]</p>
                            <InputFile id="add-asset" OnChange="e => AddArchivesAsync(e, CatalogEntry.KindAsset)" accept=".zip" multiple />
                        </div>
                    </section>
                }
            }
            else
            {
                <section class="task">
                    <h2>@choosingTitle</h2>
                    <div class="task-body">
                        <p class="note">@L["ImportSaveNote"]</p>
                        <InputFile id="import-save" OnChange="ImportSavesAsync" accept=".srcs,.srcq" multiple />
                        <p><button @onclick="BackToMenu">@L["Back"]</button></p>
                    </div>
                </section>
            }
                <section class="task settings">
                    <h2>@L["Settings"]</h2>
                    <div class="task-body">
                        <label for="language">@L["Language"]</label>
                        <select id="language" value="@WebLocalization.SelectorValue" @onchange="ChangeLanguageAsync">
                            @foreach (var language in SRCCore.UiLanguages.Supported)
                            {
                                <option value="@language.Code">@language.NativeName</option>
                            }
                            <option value="auto">@L["LanguageAuto"]</option>
                        </select>
                        <label for="theme">@L["Theme"]</label>
                        <select id="theme" value="@theme" @onchange="ChangeThemeAsync">
                            <option value="95">Windows 95</option>
                            <option value="xp">Windows XP</option>
                        </select>
                        <label for="input-mode">@L["InputMode"]</label>
                        <select id="input-mode" value="@inputMode" @onchange="ChangeInputModeAsync">
                            <option value="auto">@L["InputAuto"]</option>
                            <option value="touch">@L["InputTouch"]</option>
                            <option value="mouse">@L["InputMouse"]</option>
                        </select>
                        <label for="log-level">@L["LogLevel"]</label>
                        <select id="log-level" value="@WebLogging.Options.Level" @onchange="ChangeLogLevelAsync">
                            <option value="Trace">Trace</option>
                            <option value="Debug">Debug</option>
                            <option value="Information">Information</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>
                </section>
            </aside>
        }
        </div>
        <div class="statusbar">
            <span class="statusbar-cell">@L["ObjectCount", ObjectCount]</span>
            <span class="statusbar-cell statusbar-grip"></span>
        </div>
    </main>
}

@code {
    private enum Mode { Loading, Menu, ChooseEvent, Playing, Ended }

    public class StoredArchive
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public string Kind { get; set; }
    }

    public class StoredSave
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public double Updated { get; set; }
    }

    private Mode mode = Mode.Loading;
    private string status;

    /// <summary>シナリオ・素材を読み込んでいる間。一覧と作業ウィンドウの操作を受け付けない</summary>
    private bool busy;
    /// <summary>画面のテーマ（95・xp）。srcwebStore.setTheme で html の data-theme に反映し、localStorage に保存する</summary>
    private string theme = "95";
    /// <summary>操作の種類の設定（auto・touch・mouse）。srcwebStore.setInputMode で html の data-input に反映し、localStorage に保存する</summary>
    private string inputMode = "auto";
    private SiteConfig site = new SiteConfig();
    private List<Catalog> catalogs = new List<Catalog>();
    private List<string> catalogErrors = new List<string>();
    private List<string> userCatalogs = new List<string>();
    private string newCatalogUrl;
    private List<StoredArchive> archives = new List<StoredArchive>();
    private string choosingTitle;
    private string scenarioId;
    private string scenarioDir;
    private string defaultEve;
    private SaveSync saveSync;
    private List<StoredSave> saves = new List<StoredSave>();
    private int syncing;
    private IList<string> eventFiles = new List<string>();
    private ScreenSession session;
    private System.Threading.Timer watch;
    private bool systemMenuOpen;
    private bool confirmingBack;

    private void ToggleSystemMenu() => systemMenuOpen = !systemMenuOpen;

    private async Task CloseSystemMenu()
    {
        systemMenuOpen = false;
        await FocusScreenAsync();
    }

    private void AskBackToMenu()
    {
        systemMenuOpen = false;
        confirmingBack = true;
    }

    private async Task CancelBack()
    {
        confirmingBack = false;
        await FocusScreenAsync();
    }

    private async Task ToggleFullscreenAsync()
    {
        systemMenuOpen = false;
        await JS.InvokeVoidAsync("srcwebStore.toggleFullscreen", "screen");
        await FocusScreenAsync();
    }

    private async Task ToggleTouchUiAsync()
    {
        systemMenuOpen = false;
        await JS.InvokeVoidAsync("srcwebToggleTouchUi");
        await FocusScreenAsync();
    }

    private async Task ToggleVirtualPadAsync()
    {
        systemMenuOpen = false;
        await JS.InvokeVoidAsync("srcwebToggleVirtualPad");
        await FocusScreenAsync();
    }

    // メニューを閉じたらキー入力をゲームの画面へ戻す
    private async Task FocusScreenAsync()
    {
        await JS.InvokeVoidAsync("srcwebStore.focus", "screen");
    }

    protected override async Task OnInitializedAsync()
    {
        status = L["Loading"];
        try
        {
            theme = await JS.InvokeAsync<string>("srcwebStore.getTheme");
            inputMode = await JS.InvokeAsync<string>("srcwebStore.getInputMode");
            await WebFonts.LoadAsync(Http);
            site = await SiteConfig.LoadAsync(Http);
            await JS.InvokeVoidAsync("srcwebStore.setTitle", site.Title);
            var query = ParseQuery(new Uri(Nav.Uri).Query);
            if (site.AllowUserCatalogs)
            {
                userCatalogs = await JS.InvokeAsync<List<string>>("srcwebStore.listCatalogs") ?? new List<string>();
            }
            var urls = site.Catalogs.ToList();
            if (site.AllowUserCatalogs)
            {
                urls.AddRange(userCatalogs);
                if (query.TryGetValue("catalog", out var queryCatalog))
                {
                    // URL で指定したカタログはこの表示の間だけ使う（追加はしない）
                    urls.Add(queryCatalog);
                }
            }
            await LoadCatalogsAsync(urls);
            if (site.AllowUserArchives)
            {
                await RefreshArchivesAsync();
            }
            status = null;
            mode = Mode.Menu;

            // URL・サイトの設定で指定されたシナリオをすぐに始める
            if (site.AllowUserCatalogs && query.TryGetValue("archive", out var archiveUrl))
            {
                query.TryGetValue("eve", out var eve);
                query.TryGetValue("root", out var root);
                query.TryGetValue("requires", out var requires);
                var uri = new Uri(Http.BaseAddress, archiveUrl);
                await PlayCatalogAsync(new CatalogEntry
                {
                    Id = "url-" + Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(uri.ToString())))[..16],
                    Title = Path.GetFileName(uri.AbsolutePath),
                    Archive = uri.ToString(),
                    Eve = eve,
                    Root = root,
                    Requires = (requires ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
                });
            }
            else if ((query.TryGetValue("play", out var id) || !string.IsNullOrEmpty(id = site.Start)))
            {
                var entry = FindEntry(id);
                if (entry == null)
                {
                    status = L["ScenarioNotInCatalog", id];
                }
                else
                {
                    await PlayCatalogAsync(entry);
                }
            }
        }
        catch (Exception ex)
        {
            status = L["InitFailed", ex.Message];
            WebLogging.Log.LogError(ex, "初期化できません");
        }
    }

    private static Dictionary<string, string> ParseQuery(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var index = pair.IndexOf('=');
            var key = Uri.UnescapeDataString((index < 0 ? pair : pair[..index]).Replace('+', ' '));
            var value = index < 0 ? "" : Uri.UnescapeDataString(pair[(index + 1)..].Replace('+', ' '));
            result.TryAdd(key, value);
        }
        return result;
    }

    // ── カタログ ──

    private async Task LoadCatalogsAsync(IEnumerable<string> urls)
    {
        catalogs = new List<Catalog>();
        catalogErrors = new List<string>();
        foreach (var url in urls.Distinct())
        {
            try
            {
                catalogs.Add(await Catalog.LoadAsync(Http, url));
            }
            catch (Exception ex)
            {
                catalogErrors.Add(L["CatalogLoadFailed", url, ex.Message]);
                WebLogging.Log.LogWarning(ex, "カタログを読めません {Url}", url);
            }
        }
    }

    /// <summary>id のエントリ。先に読んだカタログを優先する</summary>
    private CatalogEntry FindEntry(string id, string kind = CatalogEntry.KindScenario)
    {
        return catalogs.SelectMany(x => x.Entries).FirstOrDefault(x => x.Id == id && x.Kind == kind);
    }

    private string PlayLink(CatalogEntry entry)
    {
        // サイトのカタログにあるものは id だけで開ける。追加したカタログのものはカタログの URL も付ける
        var catalog = catalogs.FirstOrDefault(x => x.Entries.Contains(entry));
        var link = "?play=" + Uri.EscapeDataString(entry.Id);
        if (catalog != null && !site.Catalogs.Any(x => new Uri(Http.BaseAddress, x).ToString() == catalog.Url))
        {
            link += "&catalog=" + Uri.EscapeDataString(catalog.Url);
        }
        return link;
    }

    private async Task AddCatalogAsync()
    {
        var url = newCatalogUrl?.Trim();
        if (string.IsNullOrEmpty(url))
        {
            return;
        }
        try
        {
            var catalog = await Catalog.LoadAsync(Http, url);
            if (!userCatalogs.Contains(catalog.Url))
            {
                userCatalogs.Add(catalog.Url);
                await JS.InvokeVoidAsync("srcwebStore.saveCatalogs", userCatalogs);
                catalogs.Add(catalog);
            }
            newCatalogUrl = null;
            status = null;
        }
        catch (Exception ex)
        {
            status = L["CatalogLoadFailed", url, ex.Message];
        }
    }

    private async Task RemoveCatalogAsync(string url)
    {
        userCatalogs.Remove(url);
        await JS.InvokeVoidAsync("srcwebStore.saveCatalogs", userCatalogs);
        catalogs.RemoveAll(x => x.Url == url);
    }

    // ── 追加したアーカイブ ──

    private async Task RefreshArchivesAsync()
    {
        archives = await JS.InvokeAsync<List<StoredArchive>>("srcwebStore.list");
    }

    private Task AddArchivesAsync(InputFileChangeEventArgs e, string kind) => RunBusyAsync(async () =>
    {
        foreach (var file in e.GetMultipleFiles(32))
        {
            status = L["AddingArchive", file.Name];
            StateHasChanged();
            using var stream = file.OpenReadStream(maxAllowedSize: 2L * 1024 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            await JS.InvokeVoidAsync("srcwebStore.put", file.Name, buffer.ToArray(), kind);
        }
        status = null;
        await RefreshArchivesAsync();
    });

    /// <summary>
    /// 読み込みの間、ほかの操作（別のシナリオの選択・削除・追加など）を受け付けない。
    /// 画面が inert になる前に続けて押された分も、ここで捨てる
    /// </summary>
    private async Task RunBusyAsync(Func<Task> action)
    {
        if (busy)
        {
            return;
        }
        busy = true;
        StateHasChanged();
        try
        {
            await action();
        }
        finally
        {
            busy = false;
            StateHasChanged();
        }
    }

    private async Task DeleteArchiveAsync(StoredArchive archive)
    {
        await JS.InvokeVoidAsync("srcwebStore.remove", archive.Name);
        await RefreshArchivesAsync();
    }

    private Task PlayCatalogAsync(CatalogEntry entry) => RunBusyAsync(async () =>
    {
        if (!await PrepareAssetsAsync(entry.Requires))
        {
            return;
        }
        await LoadAsync("catalog-" + entry.Id, entry.Title, () => DownloadAsync(entry.Archive, entry.Version), entry.Eve, entry.Root);
    });

    /// <summary>この大きさを超える zip は、メモリ（byte[]）に読まずにブラウザ内のファイルシステムに書いてから展開する</summary>
    private const long StreamToFileThreshold = 32L * 1024 * 1024;

    /// <summary>
    /// zip をダウンロードして開く。展開したら Dispose し、FileStream ならファイルを消す（CloseDownload）。
    /// 一度取得した zip はブラウザの Cache Storage に置き、次からはネットワークを使わない（version が変われば取得し直す。srcwebStore.fetchArchive）。
    /// 応答を byte[] に読むと、大きいシナリオ（数百 MB）では WebAssembly のメモリがその分（読み込み中はそれ以上）増え、
    /// 増えたメモリは返せないため、スマートフォンではタブが落ちる原因になる。
    /// 大きいものはストリームのままファイルに書く。WebAssembly のメモリは一度に読む分しか使わない（ファイルの中身は JS 側のメモリに置かれる）。
    /// 小さいものは、展開が速いため従来どおりメモリに読む。
    /// </summary>
    private async Task<Stream> DownloadAsync(string url, string version)
    {
        await using var archive = await JS.InvokeAsync<IJSStreamReference>("srcwebStore.fetchArchive", url, version ?? "");
        using var source = await archive.OpenReadStreamAsync(long.MaxValue);
        return await OpenDownloadAsync(source, archive.Length);
    }

    /// <summary>zip を、小さいものはメモリに、大きいものはファイルに書いて開く</summary>
    private static async Task<Stream> OpenDownloadAsync(Stream source, long length)
    {
        if (length <= StreamToFileThreshold)
        {
            var buffer = new MemoryStream((int)length);
            await source.CopyToAsync(buffer, 1024 * 1024);
            buffer.Position = 0;
            return buffer;
        }
        var path = ScenarioArchive.NewDownloadPath();
        try
        {
            using (var file = new FileStream(path, FileMode.Create, FileAccess.ReadWrite, FileShare.None, 1024 * 1024))
            {
                // 先に大きさを決めておくと、書き込むたびにファイルの領域を広げ直さない
                file.SetLength(length);
                await source.CopyToAsync(file, 1024 * 1024);
                file.SetLength(file.Position);
            }
            return ScenarioArchive.OpenDownload(path);
        }
        catch
        {
            DeleteDownload(path);
            throw;
        }
    }

    /// <summary>DownloadAsync で開いた zip を閉じ、ファイルに書いたものは消す</summary>
    private static void CloseDownload(Stream zip)
    {
        zip.Dispose();
        if (zip is FileStream file)
        {
            DeleteDownload(file.Name);
        }
    }

    private static void DeleteDownload(string path)
    {
        try
        {
            if (File.Exists(path))
            {
                File.Delete(path);
            }
        }
        catch (Exception ex)
        {
            WebLogging.Log.LogWarning(ex, "ダウンロードを消せません {Path}", path);
        }
    }

    /// <summary>
    /// 素材を SRC のフォルダに重ねる。利用者が追加した素材を先に、シナリオが求める素材（requires）を後に展開する（後のものが優先）。
    /// </summary>
    private async Task<bool> PrepareAssetsAsync(IEnumerable<string> requires)
    {
        if (site.AllowUserArchives)
        {
            foreach (var archive in archives.Where(x => x.Kind == CatalogEntry.KindAsset))
            {
                status = L["ExtractingAsset", archive.Name];
                StateHasChanged();
                var data = await JS.InvokeAsync<byte[]>("srcwebStore.get", archive.Name);
                await Task.Run(() => ScenarioArchive.ExtractAsset(data));
            }
        }
        foreach (var id in requires ?? Enumerable.Empty<string>())
        {
            var asset = FindEntry(id, CatalogEntry.KindAsset);
            if (asset == null)
            {
                status = L["AssetNotInCatalog", id];
                return false;
            }
            try
            {
                status = L["LoadingAsset", asset.Title];
                StateHasChanged();
                var zip = await DownloadAsync(asset.Archive, asset.Version);
                try
                {
                    status = L["ExtractingAsset", asset.Title];
                    StateHasChanged();
                    await Task.Run(() => ScenarioArchive.ExtractAsset(zip, asset.Root));
                }
                finally
                {
                    CloseDownload(zip);
                }
            }
            catch (Exception ex)
            {
                status = L["AssetLoadFailed", asset.Title, ex.Message];
                WebLogging.Log.LogError(ex, "素材を読み込めません {Asset}", asset.Title);
                return false;
            }
        }
        return true;
    }

    private Task PlayArchiveAsync(StoredArchive archive) => RunBusyAsync(async () =>
    {
        if (!await PrepareAssetsAsync(null))
        {
            return;
        }
        await LoadAsync("archive-" + archive.Name, archive.Name, async () => new MemoryStream(await JS.InvokeAsync<byte[]>("srcwebStore.get", archive.Name), false), null, null);
    });

    /// <param name="fetch">zip を開く。展開したら CloseDownload で閉じる</param>
    private async Task LoadAsync(string id, string title, Func<Task<Stream>> fetch, string eve, string root)
    {
        try
        {
            status = L["LoadingArchive", title];
            StateHasChanged();
            var zip = await fetch();
            try
            {
                status = L["ExtractingArchive", title];
                StateHasChanged();
                scenarioId = id;
                scenarioDir = await Task.Run(() => ScenarioArchive.Extract(id, zip, root));
            }
            finally
            {
                CloseDownload(zip);
            }
            eventFiles = ScenarioArchive.FindEventFiles(scenarioDir);
            defaultEve = !string.IsNullOrEmpty(eve) && File.Exists(Path.Combine(scenarioDir, eve)) ? eve : eventFiles.FirstOrDefault();
            await RestoreSavesAsync();
            if (eventFiles.Count == 0)
            {
                status = L["NoEventFiles", title];
            }
            else if (saves.Count == 0 && (!string.IsNullOrEmpty(eve) && defaultEve == eve || eventFiles.Count == 1))
            {
                await StartAsync(Path.Combine(scenarioDir, defaultEve));
            }
            else
            {
                status = null;
                choosingTitle = title;
                mode = Mode.ChooseEvent;
            }
        }
        catch (Exception ex)
        {
            status = L["LoadFailed", title, ex.Message];
            WebLogging.Log.LogError(ex, "シナリオを読み込めません {Title}", title);
        }
    }

    // ── セーブデータ ──

    private async Task RestoreSavesAsync()
    {
        saveSync = new SaveSync(scenarioDir);
        saves = await JS.InvokeAsync<List<StoredSave>>("srcwebStore.listSaves", scenarioId);
        foreach (var save in saves)
        {
            var data = await JS.InvokeAsync<byte[]>("srcwebStore.getSave", scenarioId, save.Name);
            if (data != null)
            {
                saveSync.Restore(save.Name, data);
            }
        }
    }

    /// <summary>ゲームが書いたセーブデータをブラウザに保存する</summary>
    private async Task SyncSavesAsync()
    {
        if (saveSync == null || Interlocked.Exchange(ref syncing, 1) == 1)
        {
            return;
        }
        try
        {
            // 保存している間に書かれたものも続けて保存する
            while (saveSync.HasWritten)
            {
                var written = saveSync.CollectWritten();
                if (written.Count == 0)
                {
                    break;
                }
                foreach (var (name, data) in written)
                {
                    await JS.InvokeVoidAsync("srcwebStore.putSave", scenarioId, name, data);
                }
            }
        }
        catch (Exception ex)
        {
            WebLogging.Log.LogWarning(ex, "セーブデータをブラウザに保存できません");
        }
        finally
        {
            syncing = 0;
        }
    }

    private async Task ImportSavesAsync(InputFileChangeEventArgs e)
    {
        // シナリオ（.eve）と同じフォルダに置く
        var folder = Path.GetDirectoryName(defaultEve ?? "")?.Replace('\\', '/') ?? "";
        foreach (var file in e.GetMultipleFiles(32))
        {
            if (!SaveSync.IsSaveFile(file.Name))
            {
                continue;
            }
            using var stream = file.OpenReadStream(maxAllowedSize: 64L * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var name = string.IsNullOrEmpty(folder) ? file.Name : folder + "/" + file.Name;
            await JS.InvokeVoidAsync("srcwebStore.putSave", scenarioId, name, buffer.ToArray());
        }
        await RestoreSavesAsync();
    }

    private async Task ExportSaveAsync(StoredSave save)
    {
        var data = await JS.InvokeAsync<byte[]>("srcwebStore.getSave", scenarioId, save.Name);
        if (data != null)
        {
            await JS.InvokeVoidAsync("srcwebStore.download", Path.GetFileName(save.Name), data);
        }
    }

    private async Task DeleteSaveAsync(StoredSave save)
    {
        await JS.InvokeVoidAsync("srcwebStore.removeSave", scenarioId, save.Name);
        var path = Path.Combine(scenarioDir, save.Name);
        if (File.Exists(path))
        {
            File.Delete(path);
        }
        await RestoreSavesAsync();
    }

    private static string FormatTime(double unixMillis)
    {
        return DateTimeOffset.FromUnixTimeMilliseconds((long)unixMillis).ToLocalTime().ToString("yyyy/MM/dd HH:mm");
    }

    // ── プレイ ──

    private async Task StartAsync(string evePath)
    {
        status = null;
        mode = Mode.Playing;
        StateHasChanged();
        // canvas を表示してから始める
        await Task.Delay(1);
        Directory.CreateDirectory(ScenarioArchive.AppPath);
        var host = new WebScreenHost(scenarioDir, L);
        // MIDI の SoundFont は同梱しない。アーカイブに含まれる .sf2 を使う。
        // シナリオのものを優先し、無ければ素材（requires や利用者が追加した素材。SRC のフォルダに展開される）のものを使う
        var roots = new[] { scenarioDir, ScenarioArchive.AppPath };
        var player = new WebSoundPlayer(host, () =>
        {
            var sf2 = roots
                .Where(Directory.Exists)
                .Select(root => Directory.GetFiles(root, "*.sf2", SearchOption.AllDirectories).OrderBy(x => x, StringComparer.Ordinal).FirstOrDefault())
                .FirstOrDefault(x => x != null);
            return sf2 == null ? null : new MeltySynth.SoundFont(sf2);
        });
        session = new ScreenSession(host, ScenarioArchive.AppPath, soundPlayer: player, loggerFactory: LoggerFactory);
        // シナリオの設定ファイルのログの設定（Log セクション）
        WebLogging.ApplyConfig(session.SRC.SystemConfig);
        // ゲームがセーブデータを書き終えたら、UI のスレッドでブラウザに保存する
        var sync = saveSync;
        session.SRC.FileSystem.FileWritten += path =>
        {
            if (sync?.Notify(path) ?? false)
            {
                InvokeAsync(SyncSavesAsync);
            }
        };
        session.Game.UnhandledException += (s, e) =>
        {
            WebLogging.Log.LogCritical(e.Exception, "ゲームの実行中の例外");
            host.ReportError(e.Exception.GetType().FullName, e.Exception.Message, e.Exception.ToString());
        };
        // イベントエラーなど、ゲームが出すエラーのダイアログも送る（シナリオの行は errorreport.js が添える）
        session.GUI.ErrorShown += message => host.ReportError("SRC.ErrorMessage", message, "");
        WebInterop.Attach("screen", host, session);
        session.Start(evePath);
        watch = new System.Threading.Timer(_ =>
        {
            if (WebInterop.Terminated && mode == Mode.Playing)
            {
                mode = Mode.Ended;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private async Task BackToMenu()
    {
        if (mode == Mode.ChooseEvent)
        {
            mode = Mode.Menu;
            return;
        }
        // ゲームスレッドは止められないため、ページを読み込み直す
        await SyncSavesAsync();
        await JS.InvokeVoidAsync("location.reload");
    }

    /// <summary>表示言語を保存し、読み込み直して反映する（カルチャは起動時にしか変えられない）</summary>
    /// <summary>アドレスバーに出す場所</summary>
    private string AddressText => mode == Mode.ChooseEvent ? site.Title + "\\" + choosingTitle : site.Title;

    /// <summary>ステータスバーに出す、一覧の項目の数</summary>
    private int ObjectCount => mode == Mode.ChooseEvent
        ? saves.Count + eventFiles.Count
        : catalogs.Sum(x => x.Scenarios.Count()) + (site.AllowUserArchives ? archives.Count : 0);

    private async Task ChangeInputModeAsync(ChangeEventArgs e)
    {
        inputMode = e.Value?.ToString() ?? "auto";
        await JS.InvokeVoidAsync("srcwebStore.setInputMode", inputMode);
    }

    private async Task ChangeThemeAsync(ChangeEventArgs e)
    {
        theme = e.Value?.ToString() ?? "95";
        await JS.InvokeVoidAsync("srcwebStore.setTheme", theme);
    }

    private async Task ChangeLogLevelAsync(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        WebLogging.SetLevel(value);
        await JS.InvokeVoidAsync("localStorage.setItem", WebLogging.StorageKey, value);
    }

    private async Task ChangeLanguageAsync(ChangeEventArgs e)
    {
        await JS.InvokeVoidAsync("localStorage.setItem", WebLocalization.StorageKey, e.Value?.ToString() ?? "");
        await JS.InvokeVoidAsync("location.reload");
    }

    private static string FormatSize(long size)
    {
        return size >= 1024 * 1024 ? $"{size / 1024.0 / 1024.0:0.0} MB" : $"{size / 1024.0:0} KB";
    }

    public void Dispose()
    {
        watch?.Dispose();
    }
