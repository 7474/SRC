@using SRCRender
@using System.IO
@using System.Threading
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<WebStrings> L
@inject Microsoft.Extensions.Logging.ILoggerFactory LoggerFactory

@if (mode == Mode.Playing || mode == Mode.Ended)
{
    <div class="play">
    <div class="screen-wrap">
        <canvas id="screen" width="@ScreenLayout.Width" height="@ScreenLayout.Height" tabindex="0"></canvas>
        @* タッチ向けの選択画面（タッチの端末で、ゲームのリスト・メニュー・ダイアログを大きなボタンで出す）。中身は srcweb.js が作る *@
        <div id="touch-ui" class="touch-ui" role="dialog" hidden data-cancel="@L["TouchCancel"]"></div>
        @if (mode == Mode.Ended)
        {
            <div class="ended">
                <div class="dialog" role="dialog" aria-label="@L["Ended"]">
                    <div class="titlebar">SRC#Web</div>
                    <div class="dialog-body">
                        <p>@L["ScenarioEnded"]</p>
                        <div class="dialog-buttons">
                            <button @onclick="BackToMenu">@L["BackToMenu"]</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @* プレイ中の操作は画面の右下の控えめなメニューにまとめる（誤って押してもすぐには終わらない） *@
    <div class="screen-bar">
        @* 仮想パッド（タッチの端末向け）。中身は srcweb.js が作る *@
        <div id="virtual-pad" class="virtual-pad" hidden></div>
        <div class="system-menu">
            <button id="system-menu-button" class="system-button" title="@L["SystemMenu"]" aria-label="@L["SystemMenu"]"
                    aria-haspopup="menu" aria-expanded="@(systemMenuOpen ? "true" : "false")" @onclick="ToggleSystemMenu">≡</button>
            @if (systemMenuOpen)
            {
                <div class="menu-backdrop" @onclick="CloseSystemMenu"></div>
                <div class="popup-menu" role="menu">
                    <button role="menuitem" @onclick="AskBackToMenu">@L["MenuBackToMenu"]</button>
                    <button role="menuitem" @onclick="ToggleFullscreenAsync">@L["MenuFullscreen"]</button>
                    <button role="menuitem" @onclick="ToggleVirtualPadAsync">@L["MenuVirtualPad"]</button>
                    <button role="menuitem" @onclick="ToggleTouchUiAsync">@L["MenuTouchUi"]</button>
                    @if (documents.Count > 0)
                    {
                        <hr />
                        <button role="menuitem" id="menu-documents" @onclick="ChooseDocument">@L["MenuDocuments"]</button>
                    }
                    <hr />
                    <button role="menuitem" @onclick="CloseSystemMenu">@L["MenuClose"]</button>
                </div>
            }
        </div>
    </div>
    @if (choosingDocument)
    {
        <div class="modal">
            <div class="dialog" role="dialog" aria-label="@L["Documents"]">
                <div class="titlebar">@L["Documents"]</div>
                <div class="dialog-body">
                    @DocumentList
                    <div class="dialog-buttons">
                        <button @onclick="CloseDocumentChooser">@L["MenuClose"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (confirmingBack)
    {
        <div class="modal">
            <div class="dialog" role="alertdialog" aria-label="@L["Confirm"]">
                <div class="titlebar">SRC#Web</div>
                <div class="dialog-body">
                    <p>@L["ConfirmBackToMenu"]<br />@L["UnsavedProgressLost"]</p>
                    <div class="dialog-buttons">
                        <button @onclick="BackToMenu">@L["Yes"]</button>
                        <button id="confirm-no" @onclick="CancelBack">@L["No"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
else
{
    @* エクスプローラー（Windows 95・XP）を模した画面。右の一覧を DOM の先に置き、左の作業ウィンドウは CSS で左に出す *@
    <main class="window explorer">
        <div class="titlebar">
            <span class="title-icon" aria-hidden="true"></span>
            <h1>@site.Title</h1>
            <span class="caption-buttons" aria-hidden="true"><span class="caption-min"></span><span class="caption-max"></span><span class="caption-close"></span></span>
        </div>
        <div class="addressbar">
            <span class="address-label">@L["Address"]</span>
            <span class="address"><span class="icon icon-folder" aria-hidden="true"></span>@AddressText</span>
        </div>
        @* シナリオ・素材を読み込んでいる間は、ほかの操作を受け付けない（inert） *@
        <div class="explorer-body" inert="@busy" aria-busy="@(busy ? "true" : "false")">
        <div class="listpane">
        @if (!busy && !string.IsNullOrEmpty(status))
        {
            <p id="status" class="status">@status</p>
        }
        @if (mode == Mode.Menu)
        {
            @foreach (var catalog in catalogs)
            {
                <section class="group catalog">
                    <h2>@(catalog.Name ?? L["RegisteredScenarios"])</h2>
                    @if (!catalog.Scenarios.Any())
                    {
                        <p class="note">@L["NoItems"]</p>
                    }
                    @* E2E テストは最初のカタログを #catalog で探す *@
                    <ul class="items" id="@(catalogs.IndexOf(catalog) == 0 ? "catalog" : null)">
                        @foreach (var entry in catalog.Scenarios)
                        {
                            <li>
                                <span class="icon icon-zip" aria-hidden="true"></span>
                                <button @onclick="() => PlayCatalogAsync(entry)">@entry.Title</button>
                                @if (site.RatingAgeOf(entry) > 0)
                                {
                                    <span class="badge rating" title="@L["RatingBadgeTitle", entry.RatingAge]">R@(entry.RatingAge)</span>
                                }
                                @if (!string.IsNullOrEmpty(entry.Author))
                                {
                                    <span class="note">@entry.Author</span>
                                }
                                @if (!string.IsNullOrEmpty(entry.License))
                                {
                                    <span class="note">@entry.License</span>
                                }
                                <a class="link" href="@PlayLink(entry)" title="@L["DirectLinkTitle"]">@L["DirectLink"]</a>
                            </li>
                        }
                    </ul>
                    @if (userCatalogs.Contains(catalog.Url))
                    {
                        <button class="delete" @onclick="() => RemoveCatalogAsync(catalog.Url)">@L["RemoveCatalog"]</button>
                    }
                </section>
            }
            @foreach (var error in catalogErrors)
            {
                <p class="status">@error</p>
            }
            @if (site.UserArchivesEnabled)
            {
                <section class="group">
                    <h2>@L["AddedArchives"]</h2>
                    <ul class="items" id="archives">
                        @foreach (var archive in archives)
                        {
                            <li @key="(archive.Name, archive.Added)">
                                @if (archive.Kind == CatalogEntry.KindAsset)
                                {
                                    <span class="icon icon-asset" aria-hidden="true"></span>
                                    <span class="name">@archive.Name</span>
                                    <span class="asset">@L["Asset"]</span>
                                }
                                else
                                {
                                    <span class="icon icon-zip" aria-hidden="true"></span>
                                    <button @onclick="() => PlayArchiveAsync(archive)">@archive.Name</button>
                                }
                                <span class="size">@FormatSize(archive.Size)</span>
                                @* 同じ名前のまま別の zip に置き換える（セーブデータは名前で引き継ぐ） *@
                                <label class="button replace" title="@L["ReplaceTitle"]">@L["Replace"]<InputFile class="hidden-file" OnChange="e => ReplaceArchiveAsync(e, archive)" accept=".zip" /></label>
                                <button class="delete" @onclick="() => DeleteArchiveAsync(archive)">@L["Delete"]</button>
                            </li>
                        }
                    </ul>
                    @if (archives.Count == 0)
                    {
                        <p class="note">@L["NoItems"]</p>
                    }
                </section>
            }
        }
        else if (mode == Mode.ChooseEvent)
        {
            <section class="group">
                <h2>@choosingTitle</h2>
                @if (documents.Count > 0)
                {
                    <h3>@L["Documents"]</h3>
                    @DocumentList
                }
                @if (saves.Count > 0)
                {
                    <h3>@L["ResumeFromSave"]</h3>
                    <ul class="items" id="saves">
                        @foreach (var save in saves)
                        {
                            <li>
                                <span class="icon icon-save" aria-hidden="true"></span>
                                <button @onclick="() => StartAsync(Path.Combine(scenarioDir, save.Name))">@save.Name</button>
                                <span class="size">@FormatTime(save.Updated)</span>
                                <button class="export" @onclick="() => ExportSaveAsync(save)">@L["Export"]</button>
                                <button class="delete" @onclick="() => DeleteSaveAsync(save)">@L["Delete"]</button>
                            </li>
                        }
                    </ul>
                }
                <h3>@L["StartNew"]</h3>
                <ul class="items" id="events">
                    @foreach (var eve in eventFiles)
                    {
                        <li><span class="icon icon-file" aria-hidden="true"></span><button @onclick="() => StartAsync(Path.Combine(scenarioDir, eve))">@eve</button></li>
                    }
                </ul>
            </section>
        }
        </div>
        @if (mode == Mode.Menu || mode == Mode.ChooseEvent)
        {
            <aside class="taskpane">
            @if (mode == Mode.Menu)
            {
                @if (site.AllowUserCatalogs)
                {
                    <section class="task">
                        <h2>@L["AddCatalog"]</h2>
                        <div class="task-body">
                            <p class="note">@L["AddCatalogNote"]</p>
                            <form class="add-catalog" @onsubmit="AddCatalogAsync">
                                <input id="catalog-url" type="url" placeholder="https://example.com/catalog.json" @bind="newCatalogUrl" />
                                <button type="submit">@L["Add"]</button>
                            </form>
                        </div>
                    </section>
                }
                @if (site.UserArchivesEnabled)
                {
                    <section class="task">
                        <h2>@L["AddArchives"]</h2>
                        <div class="task-body">
                            @if (site.UserScenariosEnabled)
                            {
                                <p class="note">@L["AddArchiveNote"]</p>
                                <InputFile id="add-archive" OnChange="e => AddArchivesAsync(e, CatalogEntry.KindScenario)" accept=".zip" multiple />
                            }
                            @if (site.UserAssetsEnabled)
                            {
                                <p class="note">@L["AddAssetNote"]</p>
                                <InputFile id="add-asset" OnChange="e => AddArchivesAsync(e, CatalogEntry.KindAsset)" accept=".zip" multiple />
                            }
                        </div>
                    </section>
                }
            }
            else
            {
                <section class="task">
                    <h2>@choosingTitle</h2>
                    <div class="task-body">
                        <p class="note">@L["ImportSaveNote"]</p>
                        <InputFile id="import-save" OnChange="ImportSavesAsync" accept=".srcs,.srcq" multiple />
                        <p><button @onclick="BackToMenu">@L["Back"]</button></p>
                    </div>
                </section>
            }
                <section class="task settings">
                    <h2>@L["Settings"]</h2>
                    <div class="task-body">
                        <label for="language">@L["Language"]</label>
                        <select id="language" value="@WebLocalization.SelectorValue" @onchange="ChangeLanguageAsync">
                            @foreach (var language in SRCCore.UiLanguages.Supported)
                            {
                                <option value="@language.Code">@language.NativeName</option>
                            }
                            <option value="auto">@L["LanguageAuto"]</option>
                        </select>
                        <label for="theme">@L["Theme"]</label>
                        <select id="theme" value="@theme" @onchange="ChangeThemeAsync">
                            <option value="95">Windows 95</option>
                            <option value="xp">Windows XP</option>
                        </select>
                        <label for="input-mode">@L["InputMode"]</label>
                        <select id="input-mode" value="@inputMode" @onchange="ChangeInputModeAsync">
                            <option value="auto">@L["InputAuto"]</option>
                            <option value="touch">@L["InputTouch"]</option>
                            <option value="mouse">@L["InputMouse"]</option>
                        </select>
                        <label for="log-level">@L["LogLevel"]</label>
                        <select id="log-level" value="@WebLogging.Options.Level" @onchange="ChangeLogLevelAsync">
                            <option value="Trace">Trace</option>
                            <option value="Debug">Debug</option>
                            <option value="Information">Information</option>
                            <option value="Warning">Warning</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>
                </section>
            </aside>
        }
        </div>
        <div class="statusbar">
            <span class="statusbar-cell">@L["ObjectCount", ObjectCount]</span>
            <span class="statusbar-cell statusbar-grip"></span>
        </div>
    </main>
    @* 読み込みの間は画面を暗くして操作できないことを示し、取り消せるようにする *@
    @if (busy)
    {
        <div class="modal loading" id="loading">
            <div class="dialog" role="alertdialog" aria-label="@L["Loading"]" aria-busy="true">
                <div class="titlebar">SRC#Web</div>
                <div class="dialog-body">
                    <p id="loading-status">@(string.IsNullOrEmpty(status) ? L["Loading"] : status)</p>
                    <div class="progress" role="progressbar" aria-label="@L["Loading"]"><span></span></div>
                    <div class="dialog-buttons">
                        <button id="cancel-loading" @onclick="CancelLoad" disabled="@(loadCancel?.IsCancellationRequested ?? true)">@L["ModalCancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @* 年齢の区分（rating）のあるシナリオは、始める前に年齢を確かめる *@
    @if (confirmingRating != null)
    {
        <div class="modal" id="rating-confirm">
            <div class="dialog" role="alertdialog" aria-label="@L["Confirm"]">
                <div class="titlebar">SRC#Web</div>
                <div class="dialog-body">
                    <p>@L["RatingConfirm", confirmingRating.RatingAge, "R" + confirmingRating.RatingAge]</p>
                    <div class="dialog-buttons">
                        <button id="rating-yes" @onclick="AcceptRatingAsync">@L["Yes"]</button>
                        <button id="rating-no" @onclick="DeclineRatingAsync">@L["No"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@* シナリオに同梱された文書。.txt はメモ帳、.md・.htm・.html は Internet Explorer（95 のテーマは IE4、XP のテーマは IE6）を模す *@
@if (viewing != null)
{
    <div class="modal doc-modal" @onclick="CloseDocumentAsync">
        <div class="doc-window @(Browsing ? "doc-browser" : "doc-notepad")" role="dialog" aria-label="@viewing.Name" id="doc-window"
             @onclick:stopPropagation="true" @onkeydown="DocumentKeyDownAsync">
            <div class="titlebar">
                <span class="icon @(Browsing ? "icon-page" : "icon-text")" aria-hidden="true"></span>
                <span class="doc-title">@(Browsing ? L["PageViewerTitle", viewingTitle ?? viewing.Name] : L["TextViewerTitle", viewing.Name])</span>
                <button class="doc-close" aria-label="@L["MenuClose"]" title="@L["MenuClose"]" @onclick="CloseDocumentAsync">×</button>
            </div>
            @* メニューバー。開いているメニューの外を押したら閉じる *@
            @if (documentMenu != null)
            {
                <div class="doc-menu-backdrop" @onclick="() => documentMenu = null"></div>
            }
            <div class="doc-menubar" role="menubar">
                @foreach (var menu in DocumentMenus)
                {
                    <div class="doc-menu">
                        <button role="menuitem" class="@(documentMenu == menu.Key ? "open" : null)" aria-haspopup="menu" aria-expanded="@(documentMenu == menu.Key ? "true" : "false")"
                                @onclick="() => documentMenu = documentMenu == menu.Key ? null : menu.Key"
                                @onmouseenter="() => { if (documentMenu != null) documentMenu = menu.Key; }">@menu.Label</button>
                        @if (documentMenu == menu.Key)
                        {
                            <div class="popup-menu doc-menu-popup" role="menu">
                                @foreach (var item in menu.Items)
                                {
                                    @if (item == null)
                                    {
                                        <hr />
                                    }
                                    else
                                    {
                                        <button role="menuitem" class="@(item.Checked ? "checked" : null)" disabled="@(!item.Enabled)" @onclick="() => RunDocumentMenuAsync(item.Action)">@item.Label</button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @if (Browsing)
            {
                @* 標準のボタン（文字付きの平らなボタン）とアドレスバーを積み、右に回る地球（スロバー）を置く *@
                <div class="ie-rebar">
                    <div class="ie-bands">
                        <div class="ie-band ie-buttons">
                            @* XP のテーマでは Internet Explorer 6 のように、絵の右に文字を出し、文字は戻る・お気に入りだけにする（ie-labeled） *@
                            <button id="doc-back" class="ie-button ie-labeled" disabled="@(historyIndex <= 0)" @onclick="() => MoveHistory(-1)" title="@L["DocumentBack"]"><span class="ie-icon ie-back" aria-hidden="true"></span><span class="ie-label">@L["DocumentBack"]</span></button>
                            <button id="doc-forward" class="ie-button" disabled="@(historyIndex >= history.Count - 1)" @onclick="() => MoveHistory(1)" title="@L["DocumentForward"]"><span class="ie-icon ie-forward" aria-hidden="true"></span><span class="ie-label">@L["DocumentForward"]</span></button>
                            <button class="ie-button" disabled title="@L["IeStop"]"><span class="ie-icon ie-stop" aria-hidden="true"></span><span class="ie-label">@L["IeStop"]</span></button>
                            <button id="doc-refresh" class="ie-button" @onclick="RefreshDocument" title="@L["IeRefresh"]"><span class="ie-icon ie-refresh" aria-hidden="true"></span><span class="ie-label">@L["IeRefresh"]</span></button>
                            <button id="doc-home" class="ie-button" disabled="@(HomeDocument == null)" @onclick="GoHome" title="@L["IeHome"]"><span class="ie-icon ie-home" aria-hidden="true"></span><span class="ie-label">@L["IeHome"]</span></button>
                            <span class="ie-separator" aria-hidden="true"></span>
                            <button class="ie-button ie-labeled" @onclick="@(() => documentMenu = "favorites")" title="@L["IeFavoritesButton"]"><span class="ie-icon ie-favorites" aria-hidden="true"></span><span class="ie-label">@L["IeFavoritesButton"]</span></button>
                        </div>
                        <form class="ie-band ie-address" @onsubmit="GoAddressAsync">
                            <label for="doc-address">@L["IeAddress"]</label>
                            <span class="ie-combo">
                                <span class="icon @(viewing.IsPage ? "icon-page" : "icon-text")" aria-hidden="true"></span>
                                <input id="doc-address" type="text" @bind="addressText" @bind:event="oninput" spellcheck="false" autocomplete="off" />
                            </span>
                            @* Internet Explorer 6（XP のテーマ）の「移動」ボタン。IE4（95 のテーマ）には無いので出さない *@
                            <button type="submit" class="ie-go"><span class="ie-icon ie-go-arrow" aria-hidden="true"></span>@L["IeGoButton"]</button>
                        </form>
                    </div>
                    <div class="ie-throbber" aria-hidden="true"></div>
                </div>
            }
            @if (viewingFrame != null)
            {
                @*
                    シナリオの HTML はスクリプトを動かさない（sandbox に allow-scripts を付けない）。外へのリンクは別のタブで開く。
                    allow-same-origin は、中のリンクのクリックを srcwebDocs.bind で受け取るため（スクリプトが動かないので中から外は触れない）
                *@
                <iframe class="doc-view doc-frame" id="doc-view" title="@viewing.Name" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" srcdoc="@viewingFrame"></iframe>
            }
            else if (viewingHtml != null)
            {
                <div class="doc-view doc-page" id="doc-view" tabindex="0">@viewingHtml</div>
            }
            else
            {
                <pre class="doc-view doc-text @(documentWrap ? "wrap" : null)" id="doc-view" tabindex="0">@viewingText</pre>
            }
            @if (Browsing)
            {
                <div class="ie-statusbar">
                    <span class="ie-status-main doc-status"><span class="icon @(documentStatus == null ? "icon-page" : "icon-error")" aria-hidden="true"></span>@(documentStatus ?? L["IeDone"])</span>
                    <span class="ie-status-pane" aria-hidden="true"></span>
                    <span class="ie-status-zone"><span class="icon icon-computer" aria-hidden="true"></span>@L["IeZone"]</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum Mode { Loading, Menu, ChooseEvent, Playing, Ended }

    public class StoredArchive
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public double Added { get; set; }
        public string Kind { get; set; }
    }

    public class StoredSave
    {
        public string Name { get; set; }
        public long Size { get; set; }
        public double Updated { get; set; }
    }

    private Mode mode = Mode.Loading;
    private string status;

    /// <summary>シナリオ・素材を読み込んでいる間。一覧と作業ウィンドウの操作を受け付けない</summary>
    private bool busy;
    /// <summary>読み込みの取り消し。読み込みの間（busy）だけある</summary>
    private CancellationTokenSource loadCancel;
    /// <summary>画面のテーマ（95・xp）。srcwebStore.setTheme で html の data-theme に反映し、localStorage に保存する</summary>
    private string theme = "95";
    /// <summary>操作の種類の設定（auto・touch・mouse）。srcwebStore.setInputMode で html の data-input に反映し、localStorage に保存する</summary>
    private string inputMode = "auto";
    private SiteConfig site = new SiteConfig();
    private List<Catalog> catalogs = new List<Catalog>();
    /// <summary>読むカタログの URL（サイトの設定・利用者が追加したもの・URL の catalog）</summary>
    private List<string> catalogUrls = new List<string>();
    /// <summary>URL の play で、シナリオごとのカタログ（playCatalog）だけを読んでいる。一覧に戻るときはすべてのカタログを読む</summary>
    private bool catalogsLimited;
    /// <summary>年齢を確かめているシナリオ</summary>
    private CatalogEntry confirmingRating;
    private List<string> catalogErrors = new List<string>();
    private List<string> userCatalogs = new List<string>();
    private string newCatalogUrl;
    private List<StoredArchive> archives = new List<StoredArchive>();
    private string choosingTitle;
    private string scenarioId;
    private string scenarioDir;
    private string defaultEve;
    private SaveSync saveSync;
    private List<StoredSave> saves = new List<StoredSave>();
    private int syncing;
    private IList<string> eventFiles = new List<string>();
    private ScreenSession session;
    private System.Threading.Timer watch;
    /// <summary>プレイの画面（canvas）を描き終えたら完了する。StartAsync が待つ</summary>
    private TaskCompletionSource rendered;
    private bool systemMenuOpen;
    private bool confirmingBack;
    /// <summary>シナリオに同梱された文書（README・更新履歴など）</summary>
    private IList<ScenarioDocuments.Document> documents = new List<ScenarioDocuments.Document>();
    /// <summary>表示している文書。.md は viewingHtml、.txt は viewingText に入れる</summary>
    private ScenarioDocuments.Document viewing;
    private string viewingText;
    private MarkupString? viewingHtml;
    /// <summary>.htm・.html を入れる iframe の srcdoc</summary>
    private string viewingFrame;
    /// <summary>タイトルバーに出す文書のタイトル（HTML の title）。無ければファイル名</summary>
    private string viewingTitle;
    /// <summary>メモ帳の「右端で折り返す」</summary>
    private bool documentWrap = true;
    /// <summary>プレイ中にシステムメニューから文書を選んでいる</summary>
    private bool choosingDocument;
    /// <summary>開いた文書にキー入力を向ける（Esc で閉じ、矢印キーでスクロールする）</summary>
    private bool focusDocument;
    /// <summary>文書の中のリンクを受け取る（srcwebDocs.bind）。開くたびに結び直す</summary>
    private bool bindDocument;
    private DotNetObjectReference<App> documentRef;
    /// <summary>.md・.htm・.html で開いた文書の履歴（戻る・進む）</summary>
    private List<ScenarioDocuments.Document> history = new List<ScenarioDocuments.Document>();
    private int historyIndex = -1;
    /// <summary>ブラウザ風のウィンドウで出している（.md・.htm・.html から開いた）。.txt を一覧から開いたときはメモ帳</summary>
    private bool Browsing => history.Count > 0;
    /// <summary>アドレス欄</summary>
    private string addressText;
    /// <summary>文書のウィンドウの下の欄に出す知らせ（見つからないなど）。無ければパスを出す</summary>
    private string documentStatus;

    /// <summary>文書の一覧。README を先に、「はじめにお読みください」を添えて出す</summary>
    private RenderFragment DocumentList => @<ul class="items" id="documents">
        @foreach (var document in documents)
        {
            <li class="@(document.IsReadme ? "readme" : null)">
                <span class="icon @(document.IsPage ? "icon-page" : "icon-text")" aria-hidden="true"></span>
                <button @onclick="() => OpenDocument(document)">@document.Path</button>
                @if (document.IsReadme)
                {
                    <span class="badge">@L["ReadFirst"]</span>
                }
            </li>
        }
    </ul>;

    private void ChooseDocument()
    {
        systemMenuOpen = false;
        choosingDocument = true;
    }

    private async Task CloseDocumentChooser()
    {
        choosingDocument = false;
        await FocusScreenAsync();
    }

    private void OpenDocument(ScenarioDocuments.Document document)
    {
        // 一覧から開いたときは履歴を始め直す
        history.Clear();
        historyIndex = -1;
        ShowDocument(document, true);
    }

    /// <summary>文書の中のリンク（data-srcweb-doc）から開く。srcwebDocs から呼ばれる</summary>
    [JSInvokable]
    public Task OpenLinkedDocument(string path)
    {
        return InvokeAsync(() =>
        {
            var document = scenarioDir == null ? null : ScenarioDocuments.Open(scenarioDir, path);
            if (document == null)
            {
                documentStatus = L["DocumentNotFound", path];
            }
            else
            {
                ShowDocument(document, true);
            }
            StateHasChanged();
        });
    }

    private void MoveHistory(int delta)
    {
        var index = historyIndex + delta;
        if (index >= 0 && index < history.Count)
        {
            historyIndex = index;
            ShowDocument(history[index], false);
        }
    }

    /// <summary>アドレス欄のパス（シナリオのフォルダからの相対パス）か外の URL を開く</summary>
    private async Task GoAddressAsync()
    {
        var text = addressText?.Trim() ?? "";
        if (Uri.TryCreate(text, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
        {
            await JS.InvokeVoidAsync("srcwebDocs.openExternal", uri.ToString());
            addressText = viewing?.Path;
            return;
        }
        await OpenLinkedDocument(text);
    }

    /// <param name="push">履歴に積む（戻る・進むで動くときは積まない）</param>
    private void ShowDocument(ScenarioDocuments.Document document, bool push)
    {
        // .md・.htm・.html から辿った .txt もブラウザの中で出す（往年のブラウザと同じ）
        if (push && (document.IsPage || history.Count > 0))
        {
            history.RemoveRange(historyIndex + 1, history.Count - historyIndex - 1);
            history.Add(document);
            historyIndex = history.Count - 1;
        }
        documentStatus = null;
        addressText = document.Path;
        viewingText = null;
        viewingHtml = null;
        viewingFrame = null;
        viewingTitle = null;
        try
        {
            if (document.IsHtml)
            {
                viewingFrame = ScenarioDocuments.RenderHtml(scenarioDir, document, out viewingTitle);
            }
            else if (document.IsMarkdown)
            {
                viewingHtml = new MarkupString(ScenarioDocuments.RenderMarkdown(scenarioDir, document));
            }
            else
            {
                viewingText = ScenarioDocuments.ReadText(scenarioDir, document);
            }
        }
        catch (Exception ex)
        {
            viewingText = L["DocumentOpenFailed", document.Path, ex.Message];
            WebLogging.Log.LogWarning(ex, "文書を開けません {Path}", document.Path);
        }
        choosingDocument = false;
        viewing = document;
        focusDocument = true;
        bindDocument = document.IsPage;
    }

    private async Task CloseDocumentAsync()
    {
        documentMenu = null;
        viewing = null;
        viewingText = null;
        viewingHtml = null;
        viewingFrame = null;
        if (mode == Mode.Playing)
        {
            await FocusScreenAsync();
        }
    }

    private async Task DocumentKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            if (documentMenu != null)
            {
                documentMenu = null;
                return;
            }
            await CloseDocumentAsync();
        }
        else if (Browsing && e.AltKey && e.Key == "ArrowLeft")
        {
            MoveHistory(-1);
        }
        else if (Browsing && e.AltKey && e.Key == "ArrowRight")
        {
            MoveHistory(1);
        }
        else if (e.Key == "F5")
        {
            RefreshDocument();
        }
    }

    /// <summary>文書のウィンドウのメニュー。null の項目は区切り線</summary>
    private sealed record DocumentMenu(string Key, string Label, IList<DocumentMenuItem> Items);
    private sealed record DocumentMenuItem(string Label, Func<Task> Action, bool Enabled = true, bool Checked = false);

    /// <summary>開いているメニュー（DocumentMenu.Key）</summary>
    private string documentMenu;

    private static DocumentMenuItem Item(string label, Action action, bool enabled = true, bool isChecked = false)
        => new DocumentMenuItem(label, () => { action(); return Task.CompletedTask; }, enabled, isChecked);

    /// <summary>Internet Explorer 4・メモ帳（Windows 95）と同じ並びのメニュー。動かせるものだけを入れる</summary>
    private IEnumerable<DocumentMenu> DocumentMenus
    {
        get
        {
            var close = new DocumentMenuItem(L["IeClose"], CloseDocumentAsync);
            var selectAll = new DocumentMenuItem(L["IeSelectAll"], () => JS.InvokeVoidAsync("srcwebDocs.selectAll", "doc-view").AsTask());
            if (!Browsing)
            {
                yield return new DocumentMenu("file", L["IeMenuFile"], new[] { close });
                yield return new DocumentMenu("edit", L["IeMenuEdit"], new[] { selectAll, null, Item(L["WordWrap"], () => documentWrap = !documentWrap, true, documentWrap) });
                yield break;
            }
            yield return new DocumentMenu("file", L["IeMenuFile"], new[] { close });
            yield return new DocumentMenu("edit", L["IeMenuEdit"], new[] { selectAll });
            yield return new DocumentMenu("view", L["IeMenuView"], new[] { Item(L["IeRefreshMenu"], RefreshDocument) });
            yield return new DocumentMenu("go", L["IeMenuGo"], new[]
            {
                Item(L["DocumentBack"], () => MoveHistory(-1), historyIndex > 0),
                Item(L["DocumentForward"], () => MoveHistory(1), historyIndex < history.Count - 1),
                null,
                Item(L["IeHomeMenu"], GoHome, HomeDocument != null),
            });
            // お気に入り: 同梱の文書の一覧
            yield return new DocumentMenu("favorites", L["IeMenuFavorites"], documents.Select(d => Item(d.Path, () => ShowDocument(d, true), true, d.Path == viewing?.Path)).ToList());
            yield return new DocumentMenu("help", L["IeMenuHelp"], new[] { Item(L["ReadFirst"], GoHome, HomeDocument != null) });
        }
    }

    private async Task RunDocumentMenuAsync(Func<Task> action)
    {
        documentMenu = null;
        await action();
    }

    /// <summary>ホーム: README（無ければ最初の文書）</summary>
