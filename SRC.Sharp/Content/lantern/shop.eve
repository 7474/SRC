# インターミッションコマンド「よろず屋」
# 灯貨（資金）でアイテムを買い、装備を付け替える。

プロローグ:
Local 品 価格 買った 見出し
Talk ポポ
いらっしゃい！ ランタン号のみなさんなら、勉強させてもらうよ！
End

# 品書き（値段の安い順に並べる）
UnSet 価格表
価格表[真鍮装甲板] = 2500
価格表[灯油タンク] = 1500
価格表[閃光弾ポッド] = 3000
価格表[風切りの羽根] = 2000
Sort 価格表 昇順 文字インデックス
# 本日のおすすめ：風切りの羽根と灯油タンクの値段を入れ替える日替わりサービス
If 総ターン数 Mod 2 = 1 Then
  Swap 価格表[風切りの羽根] 価格表[灯油タンク]
EndIf

買った = 0
Do
  UnSet 品書き
  ForEach 品 In 価格表
    品書き[品] = 品 & "　" & 価格表[品] & Term("資金")
  Next
  品書き[付け替え] = "装備を付け替える"
  品書き[出る] = "店を出る"
  見出し = "何を買う？（手持ち：" & 資金 & Term("資金") & "）"
  Ask 品書き 見出し
  品 = 選択
  If 品 = "出る" Or 品 = "" Or 品 = "0" Then
    Break
  EndIf
  If 品 = "付け替え" Then
    ExchangeItem
    Skip
  EndIf
  価格 = 価格表[品]
  If 資金 < 価格 Then
    Talk ポポ
    ごめんね、$(Term("資金"))がちょっと足りないみたい。
    End
    Skip
  EndIf
  見出し = 品 & "を" & 価格 & Term("資金") & "で買いますか？"
  Confirm 見出し
  If 選択 = 1 Then
    Money (- 価格)
    Item 品
    Incr 買った
    PlaySound Sharara.wav
    Talk ポポ
    まいどあり！ $(品)は倉庫に入れておくね。インターミッションの「アイテム交換」で装備してね。
    End
  EndIf
Loop

If 買った > 0 Then
  Talk ポポ
  また来てね！ 気をつけて！
  End
Else
  Talk ポポ
  見るだけでも大歓迎！ また来てね！
  End
EndIf
UnSet 品書き
Continue

スタート:
Exit
