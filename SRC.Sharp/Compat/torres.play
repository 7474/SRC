# 「トレス島試験記録」を第一話から最後（第八話のゲームクリア）まで自動でプレイする（srcsharp play の PlayScript。#1549）
#   srcsharp play Compat/torres/ep01.eve --script Compat/torres.play --app-path Content/basic-data --skip-wait
# 第一話の初めの 2 ターンは、通したい機能（合体技・使い切りのアイテム・マップ攻撃・スペシャルパワー・セーブからの再開）を
# マスとメニューの操作で決まった手順で行い、結果を expect eval で確かめる。そのあとは turns で各話を自動で進め、
# インターミッションでは holdlist で止めて、乗り換え・機体改造・換装を決まった手順で行う。
# 第二話〜第八話の初めの決まった手順は torres-ep02.play〜torres-ep08.play で、その話から単体で始めて確かめる。
# 命中とダメージは乱数で変わるので、確かめるのは乱数に左右されない値（行動数・ＥＮ・アイテムの数・形態・イベントの記録）だけにする。

# 負けたときはやり直さずに終える（テストを失敗させる）
choose 試験は失敗した あきらめる

#===============================================================
# 第一話「試験場の朝」1 ターン目（試験）
#===============================================================
auto 60
expect message 試験の手順を説明します
expect eval CountItem(ノア) = 3
expect eval HP(ゴロウ) = 5400

# スペシャルパワー（味方に掛ける）：ノアの手当てで、傷んだヤマセを直す（最大ＨＰ 9000 の 30%）
cell 5 6
menu スペシャルパワー
wait list スペシャルパワー
list 手当て
stall 600
auto 3
stall 5
cell 3 13
auto 30
expect eval HP(ゴロウ) = 8100

# 使い切りのアイテム：カスミの「スパークボム」で標的Ａを撃つ。同じ名前の武器を持つアイテムが 2 つあり、
# 先に装備したアイテム「スパークボム」のほうが無くなる（元の SRC の Unit.Attack は武器の番号からアイテムを探す）
cell 5 6
menu 攻撃
wait list
list スパークボム
cell 8 6
auto 60
expect eval CountItem(ノア) = 2
expect eval Item(ノア, 1) = 試作スパークボム
expect eval IsEquiped(ノア, スパークボム) = 0

# スペシャルパワー（自分に掛ける）：カイの烈火。次の攻撃で消える
cell 6 6
menu スペシャルパワー
wait list スペシャルパワー
list 烈火
auto 30
expect eval SpecialPower(カイ, 烈火) = 1

# 合体技：トビウオのクロスストライクで標的Ｂを撃つ。パートナーのイワガネも行動済みになり、ＥＮを 20 使う
cell 6 6
menu 攻撃
wait list
list クロスストライク
cell 7 6
auto 60
expect eval SpecialPower(カイ, 烈火) = 0
expect eval Action(カイ) = 0
expect eval Action(ダイチ) = 0
expect eval EN(ダイチ) = 100
# 攻撃のラベル（常時のラベルと、同じ文字列の 2 つのラベル）
expect message 最初の一撃、いくぞ！
expect eval 攻撃総数 = 1
expect eval 攻撃記録 = 0

# マップ攻撃：ヤマセの散弾砲（扇型）で、南の標的Ｃを 2 つまとめて撃つ
cell 3 13
menu 攻撃
wait list
list 散弾砲
cell 5 13
auto 60
expect eval Action(ゴロウ) = 0

cell 1 1 right
menu ターン終了
auto 60

#===============================================================
# 第一話 2 ターン目
#===============================================================
expect eval ターン数 = 2
# 1 ターン目の敵のフェイズに現れた錆蟲ボマーが、敵の思考でマップ攻撃（錆散布）を使った
expect message 試験場の地下に反応
expect eval 敵マップ攻撃 = 1
expect message 錆蟲の群れが接近
# イベントの SpecialPower（全味方の鼓舞）と IncreaseMorale で、カイの気力は 120 以上
expect eval Morale(カイ) >= 120
# 使い切りのアイテムの 2 つめ（同じ名前の武器）で予備の標的を撃つ。2 つとも無くなる
cell 5 6
menu 攻撃
wait list
list スパークボム
cell 5 9
auto 60
expect eval CountItem(ノア) = 1
expect eval Item(ノア, 1) = 携行修理キット
# 予備の標的の隣にいる錆蟲衛兵が、味方の攻撃に対して援護防御（サポートガード）をする
expect message ガガッ！（錆蟲衛兵が仲間をかばった）

# セーブ：クイックセーブして、カイが集心を使ったあとでクイックロードすると、使う前に戻る。
# 同じマップのクイックロードでは、再開のイベントは起きない（元の SRC の RestoreData は、マップが変わったときだけ起こす）
cell 1 1 right
menu クイックセーブ
auto 30
expect eval SpecialPower(カイ, 集心) = 0
cell 6 6
menu スペシャルパワー
wait list スペシャルパワー
list 集心
auto 30
expect eval SpecialPower(カイ, 集心) = 1
cell 1 1 right
menu クイックロード
wait dialog
dialog OK
auto 30
expect eval SpecialPower(カイ, 集心) = 0
expect eval 再開記録 = 0
expect eval CountItem(ノア) = 1
expect eval ターン数 = 2
# 中断：中断データ（ep01を中断.srcq）を書いて SRC を終え、起動し直して中断データから再開する。
# マップが変わる（何も無いところから読む）ので、再開のイベントが起きる
savefile default
cell 1 1 right
menu 中断
wait dialog
dialog OK
wait finished
resume
auto 60
expect message 記録を読み込みました。試験を再開します。（ターン2）
expect eval 再開記録 = 1
expect eval ターン数 = 2
expect eval CountItem(ノア) = 1
expect eval Item(ノア, 1) = 携行修理キット
expect eval Morale(カイ) >= 120
expect eval 敵マップ攻撃 = 1
expect eval 攻撃総数 = 1
turns 1
auto 60

#===============================================================
# 第一話 3 ターン目以降
#===============================================================
# スペシャルパワーの自動発動：気力 120 以上のカイに、ターンの初めに集心が掛かる
expect eval ターン数 = 3
expect eval SpecialPower(カイ, 集心) = 1
# ここから最後まで自動で進める（SRCRenderTests の CompatScenarioTests は、この行の手前までを流す）
# 全滅 敵 → Continue → エピローグ → インターミッション（第二話の前）。
# インターミッションのコマンドのリストでは止まり、手順で選ぶ（holdlist は list で選ぶと解けるので、次のインターミッションの前にもう一度 holdlist）
holdlist コマンド
turns 60
expect message 試験は合格
expect eval 試験記録 = "第一話の試験;"

#===============================================================
# 第二話の前のインターミッション → 第二話「錆の巣」
#===============================================================
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 錆蟲の巣は、東の錆の原の奥にあ
expect message 合体、ミカヅチ！
expect message 巣が……崩れていく！
expect eval 試験記録 = "第一話の試験;第二話の調査;"
# 第二話の終わりに千草リンが加わり、Option 乗り換え でインターミッションに「乗り換え」が出る
expect eval Unit(リン) = 試作機ヒバリ

#===============================================================
# 第三話の前のインターミッション：乗り換え（リンをトビウオのサポートに乗せる） → 第三話「霧の水路」
#===============================================================
list 乗り換え
wait list
list リン
wait list 乗り換え先選択
list トビウオ
# 乗り換えのパイロットの一覧に戻るので、キャンセルしてコマンドのリストに戻る
wait list
key Escape
wait list コマンド
expect eval Unit(リン) = 試作機トビウオ
expect eval CountPilot(カイ) = 2
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 測量、完了です
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;"

#===============================================================
# 第四話の前のインターミッション：機体改造（トビウオを 1 段階）・乗り換え（リンをヒバリに戻す） → 第四話「空の回廊」
#===============================================================
expect eval Info(ユニット, 試作機トビウオ, ランク) = 0
list 機体改造
wait list
list トビウオ
wait dialog
dialog OK
wait list
key Escape
wait list コマンド
expect eval Info(ユニット, 試作機トビウオ, ランク) = 1
list 乗り換え
wait list
# パイロットの一覧で、カイの行も「トビウオ (リン)」と出るので、サポートの印（*）の付いたリンの行を選ぶ
list *リン
wait list 乗り換え先選択
list ヒバリ
wait list
key Escape
wait list コマンド
expect eval Unit(リン) = 試作機ヒバリ
expect eval CountPilot(カイ) = 1
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 回廊、制圧！
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;第四話の飛行;"

#===============================================================
# 第五話の前のインターミッション：換装（ヒバリを地底装備にする） → 第五話「地下坑道」
#===============================================================
list 換装
wait list
list ヒバリ
wait list
list 地底
wait list
key Escape
wait list コマンド
# 換装した形態にだけある追加サポート（測量ドローン）が乗る
expect eval Unit(リン) = 試作機ヒバリ(地底装備)
expect eval Unit(測量ドローン) = 試作機ヒバリ(地底装備)
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 母ハ、月ノ裏ニ
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;第四話の飛行;第五話の坑道;"

#===============================================================
# 第六話「月の裏」（Load moon）
#===============================================================
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 暗礁の陰から
expect eval 月データ後 = 月面錆蟲
expect eval 増援記録 = 月面錆蟲
expect message 月の錆蟲、全部落とした
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;第四話の飛行;第五話の坑道;第六話の月面;"

#===============================================================
# 第七話の前のインターミッション：クリアデータの引き継ぎ（話をまたいだ変数・改造・固定したアイテム・換装） → 第七話「錆の母」
#===============================================================
expect eval Info(ユニット, 試作機トビウオ, ランク) = 1
expect eval IsEquiped(カイ, 学舎の徽章) = 1
expect eval Unit(リン) = 試作機ヒバリ(地底装備)
list 次のステージへ
dialog OK
holdlist コマンド
turns 60
expect message 錆の母が……静かになった
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;第四話の飛行;第五話の坑道;第六話の月面;第七話の決戦;"

#===============================================================
# 第八話「試験の終わり」 → ゲームクリア
#===============================================================
list 次のステージへ
dialog OK
turns 30
expect message 全員、合格よ
expect message トレス島試験記録　おわり
expect eval 撃破記録 = 撃破総数 - 1
expect eval 攻撃記録 = 攻撃総数 - 1
expect eval 試験記録 = "第一話の試験;第二話の調査;第三話の測量;第四話の飛行;第五話の坑道;第六話の月面;第七話の決戦;第八話の卒業;"
expect finished
expect error none
