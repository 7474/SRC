Call 記録 "関数.InStrRev" InStrRev("一日一善","一")
Call 記録 "関数.InStrRev.3" InStrRev("毎日毎日","日",3)
Call 記録 "関数.IsNumeric" IsNumeric("125")
Call 記録 "関数.Left" Left("如月舞",2)
Call 記録 "関数.Left.長すぎ" Left("如月舞",10)
Call 記録 "関数.Len" Len("如月舞")
Call 記録 "関数.LSet" ("[" & LSet("如月舞",8) & "]")
Call 記録 "関数.LSet.短い" ("[" & LSet("abcdef",3) & "]")
Call 記録 "関数.RSet" ("[" & RSet("如月舞",8) & "]")
Call 記録 "関数.Mid" Mid("如月舞",2,1)
Call 記録 "関数.Mid.2" Mid("如月舞",2)
Call 記録 "関数.Mid.範囲外" ("[" & Mid("abc",5) & "]")
Call 記録 "関数.Replace" Replace("abcdefabcdef","cde","CDE",5)
Call 記録 "関数.Replace.2" Replace("abcdefabcdef","cde","CDE",2,6)
Call 記録 "関数.Replace.全部" Replace("aaa","a","bb")
Call 記録 "関数.Right" Right("如月舞",1)
Call 記録 "関数.StrComp" StrComp("きさらぎ","まい")
Call 記録 "関数.StrComp.大小" StrComp("a","A")
Call 記録 "関数.StrComp.同じ" StrComp("abc","abc")
Call 記録 "関数.String" String(3,"ブン")
Call 記録 "関数.Wide" Wide(365)
Call 記録 "関数.Wide.英字" Wide("Abc-1")
Call 記録 "関数.Asc" Asc("A")
Call 記録 "関数.Asc.全角" Asc("あ")
Call 記録 "関数.Chr" Chr(65)
Call 記録 "関数.LCase" LCase("Hello ＡＢＣ")
Call 記録 "関数.Trim" ("[" & Trim("  hello  ") & "]")
Call 記録 "関数.InStrB" InStrB("5月5日","日")
Call 記録 "関数.InStrRevB" InStrRevB("5月5日","5")
Call 記録 "関数.LenB" LenB("5月5日")
Call 記録 "関数.LeftB" LeftB("5月5日",3)
Call 記録 "関数.LeftB.半端" ("[" & LeftB("5月5日",2) & "]")
Call 記録 "関数.MidB" MidB("5月5日",2,3)
Call 記録 "関数.RightB" RightB("5月5日",2)
Exit

#======================================================================
# 式と関数: Format（VB の Format$。日本語版の Windows の書式で動く）
#======================================================================
*スタート:
Call 記録 "Format.##,##0.00" Format(1234.5,"##,##0.00")
Call 記録 "Format.#,###" Format(1234567,"#,###")
