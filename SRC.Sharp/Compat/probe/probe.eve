#======================================================================
# イベントコマンド: ファイルの読み書き（Open・Print・Write・Close・LineRead・Read・EOF・Dir と、ファイルとフォルダの操作）
#======================================================================
*スタート:
Open "probe_file.txt" For 出力 As ファイル
Print ファイル 一行目
Print ファイル 空白を 含む 行
Print ファイル `前後に  空白 `
Print ファイル 続ける;
Print ファイル 続き
Write ファイル "a,b" 12
Close ファイル
Open "probe_file.txt" For 追加出力 As ファイル
Print ファイル 追加した行
Close ファイル
Open "probe_file.txt" For 入力 As ファイル
LineRead ファイル 読1
LineRead ファイル 読2
LineRead ファイル 読3
LineRead ファイル 読4
Read ファイル 読5 読6
LineRead ファイル 読7
Call 記録 "コマンド.ファイル.EOF" EOF(ファイル)
Close ファイル
Call 記録 "コマンド.ファイル.Print.変数でない語" ("[" & 読1 & "]")
Call 記録 "コマンド.ファイル.Print.空白を含む" ("[" & 読2 & "]")
Call 記録 "コマンド.ファイル.Print.バッククォート" ("[" & 読3 & "]")
Call 記録 "コマンド.ファイル.Print.改行しない" ("[" & 読4 & "]")
Call 記録 "コマンド.ファイル.Write.Read.1" ("[" & 読5 & "]")
Call 記録 "コマンド.ファイル.Write.Read.2" ("[" & 読6 & "]")
Call 記録 "コマンド.ファイル.追加出力" ("[" & 読7 & "]")
Open "probe_file.txt" For 入力 As ファイル
Set 行数 0
Do While (EOF(ファイル) = 0)
  LineRead ファイル 読み捨て
  Incr 行数
Loop
Close ファイル
Call 記録 "コマンド.ファイル.行数" 行数
Exit

*スタート:
CopyFile "probe_file.txt" "probe_copy.txt"
Call 記録 "コマンド.CopyFile" Dir("probe_copy.txt")
RenameFile "probe_copy.txt" "probe_renamed.txt"
Call 記録 "コマンド.RenameFile" ("[" & Dir("probe_copy.txt") & "|" & Dir("probe_renamed.txt") & "]")
RemoveFile "probe_renamed.txt"
Call 記録 "コマンド.RemoveFile" ("[" & Dir("probe_renamed.txt") & "]")
CreateFolder "probe_dir"
Call 記録 "コマンド.CreateFolder" Dir("probe_dir","フォルダ")
RemoveFolder "probe_dir"
Call 記録 "コマンド.RemoveFolder" ("[" & Dir("probe_dir","フォルダ") & "]")
RemoveFile "probe_file.txt"
Exit

#======================================================================
# イベントコマンド: 文字列の比較（式・StrComp・If・Switch）
#======================================================================
*スタート:
Call 記録 "コマンド.比較.abc<abd" ("abc" < "abd")
Call 記録 "コマンド.比較.a<B" ("a" < "B")
Call 記録 "コマンド.比較.A=a" ("A" = "a")
Call 記録 "コマンド.比較.文字列の10<9" ("10" < "9")
Call 記録 "コマンド.比較.数値の10<9" (10 < 9)
Call 記録 "コマンド.比較.あ<ア" ("あ" < "ア")
Call 記録 "コマンド.比較.ア<ｱ" ("ア" < "ｱ")
Call 記録 "コマンド.比較.ｱ=ア" ("ｱ" = "ア")
Call 記録 "コマンド.比較.Ａ<a" ("Ａ" < "a")
Call 記録 "コマンド.比較.空<a" ("" < "a")
Call 記録 "コマンド.比較.abc>ab" ("abc" > "ab")
Call 記録 "コマンド.比較.<>" ("abc" <> "ABC")
Set 比十 "10"
Call 記録 "コマンド.比較.変数と数値" (比十 < 9)
Call 記録 "コマンド.比較.変数と文字列" (比十 < "9")
Call 記録 "コマンド.比較.変数と10.0" (比十 = 10.0)
Call 記録 "コマンド.比較.StrComp.あア" StrComp("あ","ア")
Call 記録 "コマンド.比較.StrComp.10と9" StrComp("10","9")
Set 判定 ""
If 比十 = "10.0" Then
  Set 判定 真
Else
  Set 判定 偽
EndIf
Call 記録 "コマンド.比較.If.文字列の10.0" 判定
If 比十 = 10.0 Then
  Set 判定 真
Else
  Set 判定 偽
EndIf
Call 記録 "コマンド.比較.If.数値の10.0" 判定
Set 切替 10
Switch 切替
Case 9
  Set 判定 9
Case 10
  Set 判定 10
Case Else
  Set 判定 その他
EndSw
Call 記録 "コマンド.比較.Switch.数値" 判定
Set 切替 (2 / 2)
Switch 切替
Case 1.0
  Set 判定 "1.0"
Case 1
  Set 判定 "1"
Case Else
  Set 判定 その他
EndSw
Call 記録 "コマンド.比較.Switch.1.0" 判定
Set 切替 "abc"
Switch 切替
Case ABC
  Set 判定 大文字
Case abc
  Set 判定 小文字
Case Else
  Set 判定 その他
EndSw
Call 記録 "コマンド.比較.Switch.大小" 判定
Set 切替 "a b"
Switch 切替
Case "a b"
  Set 判定 一致
Case Else
  Set 判定 その他
EndSw
Call 記録 "コマンド.比較.Switch.空白" 判定
Exit

#======================================================================
# VB5 のランタイム: 文字列の Select Case（MessageData.SelectMessage の「Case 0 To 127」）
# 相手の反撃の武器の属性（GetClassBundle で取り出したまとまり）を、文字列のまま数値の範囲と比べている。
# 「(対格属性)」などの台詞が選ばれたかと、Attack がエラーで止まらずに終わったかを見る。
# 命中・ダメージは乱数で変わるので見ない（台詞は当たる前に選ばれる）。このため、ここより後に能力値を見る項目を置かない
#======================================================================
*スタート:
Call 記録 "VB5.SelectCase.対格属性.完了" "<エラー>"
Attack ミナ 試験ブレード 反撃標的Ａ 格闘の反撃
Call 記録 "VB5.SelectCase.対格属性.完了" 1
Exit

*スタート:
Call 記録 "VB5.SelectCase.対Ｂ属性.完了" "<エラー>"
Attack ミナ 試験ブレード 反撃標的Ａ 光線の反撃
Call 記録 "VB5.SelectCase.対Ｂ属性.完了" 1
Exit

*スタート:
Call 記録 "VB5.SelectCase.対-属性.完了" "<エラー>"
Attack ミナ 試験ブレード 反撃標的Ａ 無属性の反撃
Call 記録 "VB5.SelectCase.対-属性.完了" 1
Exit

*スタート:
Call 記録 "VB5.SelectCase.台詞" (台詞[対格属性] & 台詞[対Ｂ属性] & 台詞[対-属性])
Exit

#===============================================================
# 1 ターン目の味方フェイズ（味方の 1 ターン目は Unit.Rest が動かないので、特殊状態は残る）
#===============================================================
ターン 1 味方:
Call 記録 "システム変数.ターン.ターン数" ターン数
Call 記録 "システム変数.ターン.総ターン数" 総ターン数
Call 記録 "システム変数.ターン.フェイズ" フェイズ
Call 記録 "VB5.ForEach.特殊状態.ターン後.残り3" Condition(トウマ,試験状態Ｅ)
Call 記録 "終了" 1
Quit

#===============================================================
# サブルーチン
#===============================================================
# 「項目名<TAB>値」を 1 行、出力のファイルに足す（シナリオが途中で落ちても、そこまでの行が残るように毎回開いて閉じる）
記録:
Set 記録行 (Args(1) & Chr(9) & Args(2))
Open 出力ファイル For 追加出力 As 記録番号
Print 記録番号 記録行
Close 記録番号
Return

引数三つ:
Return

# 範囲外の引数。Call 記録 を呼ぶと ArgStack が書き換わるので、先に値を取っておく
引数一つ:
Set 退避零 Args(0)
Set 退避負 Args(-1)
Set 退避二 Args(2)
Set 退避一 Args(1)
Set 退避数 ArgNum
Call 記録 "VB5.範囲外.Args(1)" 退避一
Call 記録 "VB5.範囲外.Args(2)" ("[" & 退避二 & "]")
Call 記録 "VB5.範囲外.Args(0)" ("[" & 退避零 & "]")
Call 記録 "VB5.範囲外.Args(-1)" ("[" & 退避負 & "]")
Call 記録 "VB5.範囲外.ArgNum" 退避数
Return

# メッセージデータの台詞から呼ぶ。どの台詞が選ばれたかを残す
台詞記録:
Set 台詞[Args(1)] 1
Return

足し算:
Return (Args(1) + Args(2))

変数を作る:
Local サブのローカル変数
Set サブのローカル変数 1
Set サブで作った変数 1
Return
