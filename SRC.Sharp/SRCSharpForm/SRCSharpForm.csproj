<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>$(SrcSharpTargetFramework)-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationIcon>SRCSharpForm.ico</ApplicationIcon>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<Version>$(SrcSharpAppVersion)</Version>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Melanchall.DryWetMidi" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="NAudio" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="System.Runtime.Caching" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
	  <ProjectReference Include="..\SRCLogging\SRCLogging.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>
	
	<ItemGroup>
	  <None Update="assets.zip">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>