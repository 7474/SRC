<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>SRCSharpAvalonia</RootNamespace>
    <AssemblyName>SRCSharpAvalonia</AssemblyName>
    <Product>SRC#Avalonia</Product>
    <Version>$(SrcSharpAppVersion)</Version>
    <!-- 表示文字列（Resources/Strings.resx）の既定は日本語。英語は Strings.en.resx（docs/i18n.md） -->
    <NeutralLanguage>ja</NeutralLanguage>
    <SatelliteResourceLanguages>ja;en;zh-Hans;zh-Hant;ko;fr;de;es;pt-BR;it;ru;pl;tr;th;uk</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <!-- Avalonia.Skia は SkiaSharp 3 の Linux のネイティブライブラリを引くため、SRCRender の SkiaSharp と版を揃える
         （管理側とネイティブの版が違うと起動時に失敗する。Windows・macOS のものは SkiaSharp が引く） -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <!-- 起動の確かめ（smoke）の引数と音声の再生の作り方を確かめる（App） -->
    <InternalsVisibleTo Include="SRCSharpAvaloniaTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
    <ProjectReference Include="..\SRCLogging\SRCLogging.csproj" />
    <ProjectReference Include="..\SRCRender\SRCRender.csproj" />
    <ProjectReference Include="..\SRCSound\SRCSound.csproj" />
  </ItemGroup>

  <!--
    MIDI の SoundFont（TimGM6mb、GPL-2.0）を実行ファイルの隣の SoundFont フォルダに同梱する。利用者が SoundFont を用意しなくても MIDI が鳴るように、
    探す場所の最後の候補にする（SRCSound の SoundFontLocator）。取得元は Directory.Build.props（SRC#Web と同じ）。
    取得できない（ネットワークが無い）場合はビルドを止めず、同梱しないで続ける
  -->
  <PropertyGroup>
    <BundledSoundFontDir>$(BaseIntermediateOutputPath)soundfont\</BundledSoundFontDir>
  </PropertyGroup>
  <Target Name="BundleSoundFont" BeforeTargets="AssignTargetPaths">
    <DownloadFile SourceUrl="$(SoundFontUrl)" DestinationFolder="$(BundledSoundFontDir)" Condition="!Exists('$(BundledSoundFontDir)TimGM6mb.sf2')" Retries="3" ContinueOnError="WarnAndContinue" />
    <DownloadFile SourceUrl="$(SoundFontLicenseUrl)" DestinationFolder="$(BundledSoundFontDir)" DestinationFileName="COPYING" Condition="!Exists('$(BundledSoundFontDir)COPYING')" Retries="3" ContinueOnError="WarnAndContinue" />
    <WriteLinesToFile File="$(BundledSoundFontDir)README.txt" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="utf-8" Lines="$(SoundFontReadme)" Condition="Exists('$(BundledSoundFontDir)TimGM6mb.sf2')" />
    <ItemGroup Condition="Exists('$(BundledSoundFontDir)TimGM6mb.sf2') And Exists('$(BundledSoundFontDir)COPYING')">
      <None Include="$(BundledSoundFontDir)TimGM6mb.sf2" Link="SoundFont\TimGM6mb.sf2" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <None Include="$(BundledSoundFontDir)COPYING" Link="SoundFont\COPYING" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
      <None Include="$(BundledSoundFontDir)README.txt" Link="SoundFont\README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
