<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
    <!--
      MSTEST0032（条件が常に真のアサーション）は抑止する。
      VB 版から移植した定数・列挙値（セーブデータやシナリオの互換に関わる）を固定するテストが多く、
      コンパイル時定数の比較になるため警告されるが、値が変わったときに検出するという意図どおりのテストである。
    -->
    <NoWarn>$(NoWarn);MSTEST0032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SRCCore\SRCCore.csproj" />
    <ProjectReference Include="..\SRCLogging\SRCLogging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="srcs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
