<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>SRCCore</RootNamespace>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Version>$(SrcSharpLibraryVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- .NET のコード分析（netstandard では既定で無効）。グローバリゼーションの規則を .editorconfig でエラーにしている -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- VB 版からの移植で起きやすい誤りを見つけるアナライザー（SRCPortingAnalyzers/README.md）。パッケージには含めない -->
  <ItemGroup>
    <ProjectReference Include="..\SRCPortingAnalyzers\SRCPortingAnalyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="ShiftJISExtension" />
    <PackageReference Include="System.Collections.Specialized" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
