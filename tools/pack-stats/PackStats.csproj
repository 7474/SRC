<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GSC データパックの実態の集計（7474/SRC-Data の docs/データ作成ガイドライン.md の表を再現する）。
    srcsharp の機能ではない。ソリューションには入れない。CI は tools/pack_tools_check.sh。使い方は README.md。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>PackStats</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SRC.Sharp/SRCCore/SRCCore.csproj" />
    <!-- check の「要確認」のうち、データだけで決まるものは srcsharp lint の規則を使う（7474/SRC#1617） -->
    <ProjectReference Include="../../SRC.Sharp/SRCAuthoring/SRCAuthoring.csproj" />
  </ItemGroup>

</Project>
